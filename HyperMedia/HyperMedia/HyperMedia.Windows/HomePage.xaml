<Page
    x:Class="HyperMedia.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Center Content -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- App Icon -->
                <Border Width="88" Height="88" CornerRadius="44"
                        Background="#18FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="36"
                               Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- App Name -->
                <TextBlock Text="HyperMedia"
                           FontFamily="Segoe UI Light"
                           FontSize="40"
                           Foreground="#FFFFFFFF" HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Media Player"
                           FontFamily="Segoe UI"
                           FontSize="15" Foreground="#99FFFFFF"
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <!-- Open File Button -->
                <Button x:Name="OpenButton" Click="OpenButton_Click"
                        HorizontalAlignment="Center"
                        Padding="36,14" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25A0;" FontFamily="Segoe UI Symbol" FontSize="12"
                                   Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Open File" Foreground="#FFFFFFFF" FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Drag & Drop Hint -->
                <TextBlock Text="or drag and drop a file here"
                           FontFamily="Segoe UI"
                           FontSize="12" Foreground="#66FFFFFF"
                           HorizontalAlignment="Center" Margin="0,0,0,48"/>

                <!-- Keyboard Shortcuts -->
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#44FFFFFF">
                        <Run Text="Ctrl+O"/>
                        <Run Text=" Open" Foreground="#66FFFFFF"/>
                    </TextBlock>
                    <TextBlock Text="  |  " FontFamily="Segoe UI" FontSize="12" Foreground="#33FFFFFF"/>
                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#44FFFFFF">
                        <Run Text="Space"/>
                        <Run Text=" Play/Pause" Foreground="#66FFFFFF"/>
                    </TextBlock>
                    <TextBlock Text="  |  " FontFamily="Segoe UI" FontSize="12" Foreground="#33FFFFFF"/>
                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#44FFFFFF">
                        <Run Text="Left/Right"/>
                        <Run Text=" Seek" Foreground="#66FFFFFF"/>
                    </TextBlock>
                    <TextBlock Text="  |  " FontFamily="Segoe UI" FontSize="12" Foreground="#33FFFFFF"/>
                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#44FFFFFF">
                        <Run Text="Up/Down"/>
                        <Run Text=" Volume" Foreground="#66FFFFFF"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="1" Background="Transparent" Padding="0,0,0,12">
            <TextBlock Text="v1.0" Foreground="#33FFFFFF" FontFamily="Segoe UI" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,0"/>
        </Border>
    </Grid>
</Page>
