<Page
    x:Class="HyperMedia.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0A0A0F">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackButton_Click" Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,20,0">
                    <TextBlock Text="&#x2190;" FontFamily="Segoe UI" FontSize="18"
                               Foreground="#FFFFFFFF"/>
                </Button>
                <TextBlock Text="SETTINGS" FontFamily="Segoe UI Light" FontSize="36"
                           Foreground="#FFFFFFFF" VerticalAlignment="Center"
                           CharacterSpacing="80"/>
            </StackPanel>
        </Grid>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="32,0,32,32">
            <StackPanel MaxWidth="600">

                <!-- Playback -->
                <TextBlock Text="PLAYBACK" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Volume" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="Volume level when opening a new file"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Slider x:Name="DefaultVolumeSlider" Grid.Column="1"
                            Width="160" Minimum="0" Maximum="100" Value="100"
                            VerticalAlignment="Center" Height="36"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Auto Play Next" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="Automatically play next file in playlist"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoPlayToggle" Grid.Column="1"
                                  IsOn="True" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Resume Playback" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="Remember position and resume from last spot"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="ResumeToggle" Grid.Column="1"
                                  IsOn="True" VerticalAlignment="Center"/>
                </Grid>

                <!-- Controls -->
                <TextBlock Text="CONTROLS" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Auto Hide Controls" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="Hide transport controls during playback"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoHideToggle" Grid.Column="1"
                                  IsOn="True" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Auto Hide Delay" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="Seconds before controls auto-hide"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="AutoHideDelayText" Grid.Column="1"
                               Text="3s" FontFamily="Segoe UI" FontSize="15"
                               Foreground="#FFFFFFFF" VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </Grid>

                <!-- Library -->
                <TextBlock Text="LIBRARY" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Clear Play History" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="Remove all recently played items"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="ClearHistoryBtn" Grid.Column="1"
                            Click="ClearHistory_Click"
                            Style="{StaticResource ZuneActionStyle}">
                        <TextBlock Text="CLEAR" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                   FontSize="12" CharacterSpacing="40"/>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Clear Resume Positions" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="Forget all saved playback positions"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="ClearResumeBtn" Grid.Column="1"
                            Click="ClearResume_Click"
                            Style="{StaticResource ZuneActionStyle}">
                        <TextBlock Text="CLEAR" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                   FontSize="12" CharacterSpacing="40"/>
                    </Button>
                </Grid>

                <!-- About -->
                <TextBlock Text="ABOUT" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Border Background="#08FFFFFF" Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                                       Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#FFFFFFFF" VerticalAlignment="Center" CharacterSpacing="80"/>
                        </StackPanel>
                        <TextBlock Text="Version 1.0.0" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#55FFFFFF"/>
                        <TextBlock Text="Powered by libVLC" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#55FFFFFF" Margin="0,4,0,0"/>
                        <TextBlock Text="Licensed under GPL v2" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#55FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
