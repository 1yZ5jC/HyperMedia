<Page
    x:Class="HyperMedia.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0A0A0F">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackButton_Click" Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,20,0">
                    <TextBlock Text="&#x2190;" FontFamily="Segoe UI" FontSize="18"
                               Foreground="#FFFFFFFF"/>
                </Button>
                <TextBlock Text="设置" FontFamily="Segoe UI Light" FontSize="36"
                           Foreground="#FFFFFFFF" VerticalAlignment="Center"
                           CharacterSpacing="80"/>
            </StackPanel>
        </Grid>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="32,0,32,32">
            <StackPanel MaxWidth="600">

                <!-- Playback -->
                <TextBlock Text="播放" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="默认音量" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="打开新文件时的音量级别"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Slider x:Name="DefaultVolumeSlider" Grid.Column="1"
                            Width="160" Minimum="0" Maximum="100" Value="100"
                            VerticalAlignment="Center" Height="36"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="自动播放下一个" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="自动播放播放列表中的下一个文件"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoPlayToggle" Grid.Column="1"
                                  IsOn="True" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="断点续播" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="记住上次播放位置并从断点继续"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="ResumeToggle" Grid.Column="1"
                                  IsOn="True" VerticalAlignment="Center"/>
                </Grid>

                <!-- Controls -->
                <TextBlock Text="控制" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="自动隐藏控制栏" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="播放时自动隐藏控制按钮"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoHideToggle" Grid.Column="1"
                                  IsOn="True" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="自动隐藏延迟" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="控制栏自动隐藏前的等待时间"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="AutoHideDelaySlider" Width="120"
                                Minimum="1" Maximum="10" Value="3"
                                ValueChanged="AutoHideDelaySlider_ValueChanged"
                                VerticalAlignment="Center" Height="36"/>
                        <TextBlock x:Name="AutoHideDelayText" Text="3s"
                                   FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF" VerticalAlignment="Center"
                                   Width="36" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Subtitle -->
                <TextBlock Text="字幕" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="字幕字号" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="调整外挂字幕的显示大小"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="SubtitleSizeCombo" Grid.Column="1"
                              Width="100" VerticalAlignment="Center"
                              SelectionChanged="SubtitleSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="小" Tag="16"/>
                        <ComboBoxItem Content="中" Tag="24" IsSelected="True"/>
                        <ComboBoxItem Content="大" Tag="32"/>
                        <ComboBoxItem Content="特大" Tag="40"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="字幕颜色" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="调整字幕文字颜色"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="SubtitleColorCombo" Grid.Column="1"
                              Width="100" VerticalAlignment="Center"
                              SelectionChanged="SubtitleColorCombo_SelectionChanged">
                        <ComboBoxItem Content="白色" Tag="#FFFFFFFF"/>
                        <ComboBoxItem Content="黄色" Tag="#FFFFFF00"/>
                        <ComboBoxItem Content="青色" Tag="#FF00FFFF"/>
                        <ComboBoxItem Content="绿色" Tag="#FF00FF00"/>
                        <ComboBoxItem Content="粉色" Tag="#FFFF69B4" IsSelected="True"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="字幕描边" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="为字幕添加黑色描边以提高对比度"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="SubtitleOutlineCombo" Grid.Column="1"
                              Width="100" VerticalAlignment="Center"
                              SelectionChanged="SubtitleOutlineCombo_SelectionChanged">
                        <ComboBoxItem Content="无" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="细" Tag="1"/>
                        <ComboBoxItem Content="中" Tag="2"/>
                        <ComboBoxItem Content="粗" Tag="3"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="字幕位置偏移" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="上下移动字幕显示位置"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="SubtitleMarginSlider" Width="120"
                                Minimum="-100" Maximum="100" Value="0"
                                ValueChanged="SubtitleMarginSlider_ValueChanged"
                                VerticalAlignment="Center" Height="36"/>
                        <TextBlock x:Name="SubtitleMarginText" Text="0px"
                                   FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF" VerticalAlignment="Center"
                                   Width="44" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="歌词来源" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="选择在线歌词的获取来源（无本地歌词时生效）"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="LyricSourceCombo" Grid.Column="1"
                              Width="120" VerticalAlignment="Center"
                              SelectionChanged="LyricSourceCombo_SelectionChanged">
                        <ComboBoxItem Content="自动" Tag="auto" IsSelected="True"/>
                        <ComboBoxItem Content="网易云音乐" Tag="netease"/>
                        <ComboBoxItem Content="QQ 音乐" Tag="qq"/>
                    </ComboBox>
                </Grid>

                <!-- Video -->
                <TextBlock Text="视频" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="去隔行模式" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="处理隔行扫描视频（DVD、旧录像等）"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="DeinterlaceCombo" Grid.Column="1"
                              Width="120" VerticalAlignment="Center"
                              SelectionChanged="DeinterlaceCombo_SelectionChanged">
                        <ComboBoxItem Content="自动" Tag="auto" IsSelected="True"/>
                        <ComboBoxItem Content="开启" Tag="on"/>
                        <ComboBoxItem Content="关闭" Tag="off"/>
                        <ComboBoxItem Content="Bob" Tag="bob"/>
                        <ComboBoxItem Content="Yadif" Tag="yadif"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="响度标准化" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="自动平衡不同媒体的音量差异（压缩器）"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="LoudnessToggle" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Toggled="LoudnessToggle_Toggled"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="同目录连播（剧集模式）" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="打开单个文件时自动把同目录其他媒体加入播放列表"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="EpisodeToggle" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Toggled="EpisodeToggle_Toggled"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="自动跳过片头" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="记录你手动跳过的片头位置，下次自动跳过"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="IntroSkipToggle" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Toggled="IntroSkipToggle_Toggled"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="语言" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="界面语言（立即生效）"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="120"
                              VerticalAlignment="Center"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="简体中文" Tag="zh-CN" IsSelected="True"/>
                        <ComboBoxItem Content="English" Tag="en-US"/>
                    </ComboBox>
                </Grid>

                <!-- Appearance -->
                <TextBlock Text="外观" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="浅色主页" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="主页改用浅色主题（播放器保持深色观看体验）"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="LightThemeToggle" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Toggled="LightThemeToggle_Toggled"/>
                </Grid>

                <!-- Library -->
                <TextBlock Text="媒体库" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="清除播放历史" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="删除所有最近播放记录"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="ClearHistoryBtn" Grid.Column="1"
                            Click="ClearHistory_Click"
                            Style="{StaticResource ZuneActionStyle}">
                        <TextBlock Text="清除" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                   FontSize="13" CharacterSpacing="40"/>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="睡眠定时器" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="播放指定时长后自动停止（0 = 关闭）"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SleepTimerSlider" Grid.Column="0"
                                Minimum="0" Maximum="180" StepFrequency="5" Width="140"
                                ValueChanged="SleepTimerSlider_ValueChanged"/>
                        <TextBlock x:Name="SleepTimerText" Grid.Column="1" Text="0 分钟"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#99FFFFFF"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Width="60"/>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="清除续播位置" FontFamily="Segoe UI" FontSize="15"
                                   Foreground="#FFFFFFFF"/>
                        <TextBlock Text="清除所有已保存的播放进度"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#55FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="ClearResumeBtn" Grid.Column="1"
                            Click="ClearResume_Click"
                            Style="{StaticResource ZuneActionStyle}">
                        <TextBlock Text="清除" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                   FontSize="13" CharacterSpacing="40"/>
                    </Button>
                </Grid>

                <!-- About -->
                <TextBlock Text="关于" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,16,0,16"/>

                <Border Background="#08FFFFFF" Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                                       Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#FFFFFFFF" VerticalAlignment="Center" CharacterSpacing="80"/>
                        </StackPanel>
                        <TextBlock Text="版本 1.0.0" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#55FFFFFF"/>
                        <TextBlock Text="基于 libVLC 驱动" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#55FFFFFF" Margin="0,4,0,0"/>
                        <TextBlock Text="采用 GPL v2 许可证" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#55FFFFFF" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PerfLevelText" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#FFE040FB" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
