<UserControl
    x:Class="HyperMedia.CharmSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="346" d:DesignHeight="700"
    Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,28">

            <!-- Playback -->
            <TextBlock Text="播放" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                       CharacterSpacing="80" Margin="0,0,0,10"/>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="默认音量" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"/>
                <Slider x:Name="DefaultVolumeSlider" Minimum="0" Maximum="100" Value="100"
                        Height="36" Margin="0,2,0,0" ValueChanged="DefaultVolumeSlider_ValueChanged"/>
            </StackPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="自动播放下一个" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="AutoPlayToggle" Grid.Column="1" IsOn="True"
                              MinWidth="100" Toggled="AutoPlayToggle_Toggled"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="断点续播" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="ResumeToggle" Grid.Column="1" IsOn="True"
                              MinWidth="100" Toggled="ResumeToggle_Toggled"/>
            </Grid>

            <!-- Controls -->
            <TextBlock Text="控制" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                       CharacterSpacing="80" Margin="0,18,0,10"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="自动隐藏控制栏" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="AutoHideToggle" Grid.Column="1" IsOn="True"
                              MinWidth="100" Toggled="AutoHideToggle_Toggled"/>
            </Grid>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="自动隐藏延迟" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="AutoHideDelaySlider" Grid.Column="0"
                            Minimum="1" Maximum="10" Value="3" Height="36"
                            ValueChanged="AutoHideDelaySlider_ValueChanged"/>
                    <TextBlock x:Name="AutoHideDelayText" Grid.Column="1" Text="3s"
                               FontFamily="Segoe UI" FontSize="14"
                               Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                               VerticalAlignment="Center" Width="40" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Subtitle -->
            <TextBlock Text="字幕" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                       CharacterSpacing="80" Margin="0,18,0,10"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="字幕字号" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox x:Name="SubtitleSizeCombo" Grid.Column="1" MinWidth="96"
                          VerticalAlignment="Center" SelectionChanged="SubtitleSizeCombo_SelectionChanged">
                    <ComboBoxItem Content="小" Tag="16"/>
                    <ComboBoxItem Content="中" Tag="24" IsSelected="True"/>
                    <ComboBoxItem Content="大" Tag="32"/>
                    <ComboBoxItem Content="特大" Tag="40"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="字幕颜色" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox x:Name="SubtitleColorCombo" Grid.Column="1" MinWidth="96"
                          VerticalAlignment="Center" SelectionChanged="SubtitleColorCombo_SelectionChanged">
                    <ComboBoxItem Content="白色" Tag="#FFFFFFFF"/>
                    <ComboBoxItem Content="黄色" Tag="#FFFFFF00"/>
                    <ComboBoxItem Content="青色" Tag="#FF00FFFF"/>
                    <ComboBoxItem Content="绿色" Tag="#FF00FF00"/>
                    <ComboBoxItem Content="粉色" Tag="#FFFF69B4" IsSelected="True"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="字幕描边" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox x:Name="SubtitleOutlineCombo" Grid.Column="1" MinWidth="96"
                          VerticalAlignment="Center" SelectionChanged="SubtitleOutlineCombo_SelectionChanged">
                    <ComboBoxItem Content="无" Tag="0" IsSelected="True"/>
                    <ComboBoxItem Content="细" Tag="1"/>
                    <ComboBoxItem Content="中" Tag="2"/>
                    <ComboBoxItem Content="粗" Tag="3"/>
                </ComboBox>
            </Grid>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="字幕位置偏移" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SubtitleMarginSlider" Grid.Column="0"
                            Minimum="-100" Maximum="100" Value="0" Height="36"
                            ValueChanged="SubtitleMarginSlider_ValueChanged"/>
                    <TextBlock x:Name="SubtitleMarginText" Grid.Column="1" Text="0px"
                               FontFamily="Segoe UI" FontSize="14"
                               Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                               VerticalAlignment="Center" Width="40" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="歌词来源" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox x:Name="LyricSourceCombo" Grid.Column="1" MinWidth="112"
                          VerticalAlignment="Center" SelectionChanged="LyricSourceCombo_SelectionChanged">
                    <ComboBoxItem Content="自动" Tag="auto" IsSelected="True"/>
                    <ComboBoxItem Content="网易云音乐" Tag="netease"/>
                    <ComboBoxItem Content="QQ 音乐" Tag="qq"/>
                </ComboBox>
            </Grid>

            <!-- Video -->
            <TextBlock Text="视频" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                       CharacterSpacing="80" Margin="0,18,0,10"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="去隔行模式" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox x:Name="DeinterlaceCombo" Grid.Column="1" MinWidth="112"
                          VerticalAlignment="Center" SelectionChanged="DeinterlaceCombo_SelectionChanged">
                    <ComboBoxItem Content="自动" Tag="auto" IsSelected="True"/>
                    <ComboBoxItem Content="开启" Tag="on"/>
                    <ComboBoxItem Content="关闭" Tag="off"/>
                    <ComboBoxItem Content="Bob" Tag="bob"/>
                    <ComboBoxItem Content="Yadif" Tag="yadif"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="响度标准化" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="LoudnessToggle" Grid.Column="1"
                              MinWidth="100" Toggled="LoudnessToggle_Toggled"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="同目录连播（剧集模式）" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="EpisodeToggle" Grid.Column="1"
                              MinWidth="100" Toggled="EpisodeToggle_Toggled"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="自动跳过片头" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="IntroSkipToggle" Grid.Column="1"
                              MinWidth="100" Toggled="IntroSkipToggle_Toggled"/>
            </Grid>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="睡眠定时器" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SleepTimerSlider" Grid.Column="0"
                            Minimum="0" Maximum="180" StepFrequency="5" Value="0" Height="36"
                            ValueChanged="SleepTimerSlider_ValueChanged"/>
                    <TextBlock x:Name="SleepTimerText" Grid.Column="1" Text="0 分钟"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                               VerticalAlignment="Center" Width="56" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Appearance -->
            <TextBlock Text="外观" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                       CharacterSpacing="80" Margin="0,18,0,10"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="浅色主页" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="LightThemeToggle" Grid.Column="1"
                              MinWidth="100" Toggled="LightThemeToggle_Toggled"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="语言" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="112"
                          VerticalAlignment="Center" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="简体中文" Tag="zh-CN" IsSelected="True"/>
                    <ComboBoxItem Content="English" Tag="en-US"/>
                </ComboBox>
            </Grid>

            <!-- Library -->
            <TextBlock Text="媒体库" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                       CharacterSpacing="80" Margin="0,18,0,10"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="清除播放历史" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Click="ClearHistory_Click" Style="{StaticResource ZuneActionStyle}">
                    <TextBlock Text="清除" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                               FontSize="13" CharacterSpacing="40"/>
                </Button>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="清除续播位置" FontFamily="Segoe UI Semibold" FontSize="13"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Click="ClearResume_Click" Style="{StaticResource ZuneActionStyle}">
                    <TextBlock Text="清除" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                               FontSize="13" CharacterSpacing="40"/>
                </Button>
            </Grid>

            <!-- About -->
            <TextBlock Text="关于" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                       CharacterSpacing="80" Margin="0,18,0,10"/>

            <StackPanel Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="11"
                               Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                               VerticalAlignment="Center" CharacterSpacing="80"/>
                </StackPanel>
                <TextBlock Text="版本 1.0.0 · 基于 libVLC 驱动 · GPL v2" FontFamily="Segoe UI" FontSize="11"
                           Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"/>
                <TextBlock x:Name="PerfLevelText" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#FFE040FB" Margin="0,6,0,0"/>
                <TextBlock x:Name="HardDecodeText" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#FFE040FB" Margin="0,4,0,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
