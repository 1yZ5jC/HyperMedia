<Page
    x:Class="HyperMedia.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    PointerMoved="Page_PointerMoved"
    PointerWheelChanged="Page_PointerWheelChanged"
    Background="#FF0A0A0F">

    <Page.BottomAppBar>
        <AppBar x:Name="ToolsAppBar" IsSticky="False">
            <StackPanel Orientation="Horizontal" Margin="20,0">
                <Button x:Name="RecordBtn" Click="RecordBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="录制当前视频 (转码保存)"/>
                    </ToolTipService.ToolTip>
                    <TextBlock x:Name="RecordBtnIcon" Text="&#x23FA;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="AspectRatioButton" Click="AspectRatioButton_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="画面比例"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x2B1A;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="RotateBtn" Click="RotateBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="视频旋转"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F504;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="CropBtn" Click="CropBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="画面裁剪"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x25A2;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="NightModeBtn" Click="NightModeBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="夜间护眼模式"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F319;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="AudioDeviceBtn" Click="AudioDeviceBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="音频输出设备"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F3A7;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="MiniPlayerBtn" Click="MiniPlayerBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="迷你播放器 (M)"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F3B5;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="AudioSyncBtn" Click="AudioSyncBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="音画同步"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x23F3;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="EqualizerBtn" Click="EqualizerBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="均衡器"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x266B;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="VideoFilterBtn" Click="VideoFilterBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="视频滤镜"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F3A8;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="ChapterBtn" Click="ChapterBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0"
                        Visibility="Collapsed">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="章节"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F4D6;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
<Button x:Name="StatsBtn" Click="StatsBtn_Click"
                    Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="播放统计 (Ctrl+I)"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F4CA;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="ExportM3uBtn" Click="ExportM3uBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="导出播放列表 (.m3u)"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F4E4;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
                <Button x:Name="OpenFolderBtn" Click="OpenFolderBtn_Click"
                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="打开文件所在目录 (Ctrl+E)"/>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="&#x1F4C2;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#66FFFFFF"/>
                </Button>
            </StackPanel>
        </AppBar>
    </Page.BottomAppBar>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- VIDEO AREA -->
        <Grid Grid.Column="0" Background="Black" DoubleTapped="VideoArea_DoubleTapped"
              Tapped="VideoArea_Tapped"
              ManipulationStarted="VideoArea_ManipulationStarted"
              ManipulationDelta="VideoArea_ManipulationDelta"
              ManipulationCompleted="VideoArea_ManipulationCompleted"
              ManipulationMode="TranslateX,TranslateY">
            <SwapChainPanel x:Name="VlcVideoPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="VlcVideoPanel_SizeChanged"/>

            <!-- WELCOME SCREEN -->
            <Border x:Name="WelcomeScreen" Visibility="Visible">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                            <GradientStop Color="#FF0A0A0F" Offset="0"/>
                            <GradientStop Color="#FF12081A" Offset="0.5"/>
                            <GradientStop Color="#FF0A0A0F" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,24,0,0">
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                                   Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#66FFFFFF" VerticalAlignment="Center" CharacterSpacing="80"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="32,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock Text="欢迎" FontFamily="Segoe UI Light" FontSize="56"
                                       Foreground="#FFFFFFFF" Margin="0,0,0,8"/>
                            <TextBlock Text="按 Ctrl+O 打开文件，或输入网络地址"
                                       FontFamily="Segoe UI" FontSize="18"
                                       Foreground="#66FFFFFF" Margin="0,0,0,32"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button x:Name="WelcomeOpenButton" Click="WelcomeOpenButton_Click"
                                        Style="{StaticResource ZuneActionStyle}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4C2;" FontFamily="Segoe UI Symbol" FontSize="14"
                                                   Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="打开文件" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                                   FontSize="13" VerticalAlignment="Center" CharacterSpacing="40"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WelcomeUrlButton" Click="UrlButton_Click"
                                        Style="{StaticResource ZuneActionStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F310;" FontFamily="Segoe UI Symbol" FontSize="14"
                                                   Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="打开网址" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                                   FontSize="13" VerticalAlignment="Center" CharacterSpacing="40"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="MP4" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="MKV" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="AVI" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="MP3" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="FLAC" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <TextBlock Text="+ HTTP, RTSP, MMS..." FontFamily="Segoe UI" FontSize="10"
                                           Foreground="#33FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="64,0,32,0">
                            <TextBlock Text="快捷键" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#44FFFFFF" CharacterSpacing="60" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="SPACE" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="播放 / 暂停"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#x2190; &#x2192;" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="快进 / 快退"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="F" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="切换全屏"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="A-B" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="A-B 循环播放"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#x2191; &#x2193;" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="音量增大 / 减小"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="L" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="播放列表"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+O" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="打开文件"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+U" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="打开网址"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="HyperMedia — 您的全能媒体播放器"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#22FFFFFF"
                               HorizontalAlignment="Left" Margin="32,0,0,20"/>
                </Grid>
            </Border>

            <!-- Swipe Indicator -->
            <StackPanel x:Name="SwipeIndicator" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" Margin="0,0,0,80">
                <Border Background="#40E040FB" CornerRadius="0" Padding="20,10" Margin="0,0,8,0">
                    <TextBlock Text="&#x2190; 后退" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="12"
                               CharacterSpacing="40"/>
                </Border>
                <Border Background="#4000BCD4" CornerRadius="0" Padding="20,10">
                    <TextBlock Text="快进 &#x2192;" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="12"
                               CharacterSpacing="40"/>
                </Border>
            </StackPanel>

            <!-- MUSIC: Album Art + Lyrics (shown for audio files) -->
            <Grid x:Name="MusicOverlay" Visibility="Collapsed" Margin="0,60,0,0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF0A0A0F" Offset="0"/>
                        <GradientStop Color="#CC12081A" Offset="0.5"/>
                        <GradientStop Color="#FF0A0A0F" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Album Art -->
                <Border x:Name="AlbumArtBorder" Grid.Column="0"
                        Margin="64,0,56,0" Width="420" Height="420"
                        CornerRadius="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        BorderThickness="3,0,0,0">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FFE040FB"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="#FF1A1A2E"/>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="AlbumArtImage" Grid.Row="0"
                               Stretch="Uniform" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="AlbumArtPlaceholder" Grid.Row="0"
                                   Text="&#x266B;" FontFamily="Segoe UI Symbol" FontSize="104"
                                   Foreground="#33E040FB" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="AlbumArtMetaText" Grid.Row="1"
                                   Text="" FontFamily="Segoe UI" FontSize="13"
                                   Foreground="#66FFFFFF" TextAlignment="Center"
                                   Padding="14,10,14,14" TextWrapping="Wrap"
                                   MaxWidth="420"/>
                    </Grid>
                </Border>

                <!-- Lyrics / Visualizer -->
                <Grid Grid.Column="1" Margin="0,28,56,28" VerticalAlignment="Stretch">
                    <Border x:Name="LyricsBorder"
                            CornerRadius="0"
                            VerticalAlignment="Stretch">
                        <Border.Background>
                            <SolidColorBrush Color="#10FFFFFF"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#22E040FB"/>
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <Thickness>1,0,0,0</Thickness>
                        </Border.BorderThickness>
                        <Grid Margin="28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LyricsTitle" Grid.Column="0"
                                           Text="歌词" FontFamily="Segoe UI" FontSize="18"
                                           Foreground="#44E040FB" CharacterSpacing="80"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="来源:" FontFamily="Segoe UI" FontSize="12"
                                               Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="LyricSrcAutoBtn" Click="LyricSourceButton_Click"
                                            Tag="auto" FontSize="12" Padding="12,7" Margin="0,0,4,0"
                                            Background="#33E040FB" Foreground="#FFFFFFFF" BorderThickness="0">
                                        <TextBlock Text="自动" FontSize="12" Foreground="#FFFFFFFF"/>
                                    </Button>
                                    <Button x:Name="LyricSrcNeteaseBtn" Click="LyricSourceButton_Click"
                                            Tag="netease" FontSize="12" Padding="12,7" Margin="0,0,4,0"
                                            Background="Transparent" Foreground="#88FFFFFF" BorderThickness="0">
                                        <TextBlock Text="网易云" FontSize="12" Foreground="#88FFFFFF"/>
                                    </Button>
                                    <Button x:Name="LyricSrcQqBtn" Click="LyricSourceButton_Click"
                                            Tag="qq" FontSize="12" Padding="12,7" Margin="0,0,0,0"
                                            Background="Transparent" Foreground="#88FFFFFF" BorderThickness="0">
                                        <TextBlock Text="QQ" FontSize="12" Foreground="#88FFFFFF"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="LyricsScrollViewer" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="LyricsLines">
                                    <TextBlock x:Name="LyricsPlaceholder"
                                               Text="暂无歌词"
                                               FontFamily="Segoe UI" FontSize="19"
                                               Foreground="#44FFFFFF"
                                               TextWrapping="Wrap"
                                               Margin="0,6"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Grid x:Name="VisualizerHost" Visibility="Collapsed">
                        <Image x:Name="VisualizerImage" Stretch="Fill"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- PHOTO VIEWER OVERLAY -->
            <Border x:Name="PhotoViewerOverlay" Visibility="Collapsed" Background="#FF0A0A0F">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Photo Top Bar -->
                    <Border Grid.Row="0" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#DD0A0A0F" Offset="0"/>
                                <GradientStop Color="#000A0A0F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="32,16,32,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PhotoFileName" Text=""
                                       FontFamily="Segoe UI Semibold" FontSize="15"
                                       Foreground="#FFFFFFFF" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PhotoZoomInBtn" Click="PhotoZoomInBtn_Click"
                                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="放大"/>
                                    </ToolTipService.ToolTip>
                                    <TextBlock Text="&#x2795;" FontFamily="Segoe UI Symbol" FontSize="16"
                                               Foreground="#FFFFFFFF"/>
                                </Button>
                                <TextBlock x:Name="PhotoZoomText" Text="100%"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#66FFFFFF" VerticalAlignment="Center"
                                           Width="44" TextAlignment="Center"/>
                                <Button x:Name="PhotoZoomOutBtn" Click="PhotoZoomOutBtn_Click"
                                        Style="{StaticResource ZunePrimaryStyle}" Margin="4,0,4,0">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="缩小"/>
                                    </ToolTipService.ToolTip>
                                    <TextBlock Text="&#x2796;" FontFamily="Segoe UI Symbol" FontSize="16"
                                               Foreground="#FFFFFFFF"/>
                                </Button>
                                <Button x:Name="PhotoZoomResetBtn" Click="PhotoZoomResetBtn_Click"
                                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="重置缩放"/>
                                    </ToolTipService.ToolTip>
                                    <TextBlock Text="&#x21BA;" FontFamily="Segoe UI Symbol" FontSize="16"
                                               Foreground="#FFFFFFFF"/>
                                </Button>
                                <Button x:Name="PhotoRotateBtn" Click="PhotoRotateBtn_Click"
                                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="旋转"/>
                                    </ToolTipService.ToolTip>
                                    <TextBlock Text="&#x21BB;" FontFamily="Segoe UI Symbol" FontSize="16"
                                               Foreground="#FFFFFFFF"/>
                                </Button>
                                <Button x:Name="PhotoFilterBtn" Click="PhotoFilterBtn_Click"
                                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="滤镜"/>
                                    </ToolTipService.ToolTip>
                                    <TextBlock x:Name="PhotoFilterIcon" Text="&#x1F3A8;" FontFamily="Segoe UI Symbol" FontSize="15"
                                               Foreground="#66FFFFFF"/>
                                </Button>
                                <Button x:Name="PhotoSlideshowBtn" Click="PhotoSlideshowBtn_Click"
                                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="幻灯片"/>
                                    </ToolTipService.ToolTip>
                                    <TextBlock x:Name="PhotoSlideshowIcon" Text="&#x25B6;"
                                               FontFamily="Segoe UI Symbol" FontSize="14"
                                               Foreground="#66FFFFFF"/>
                                </Button>
                                <Button x:Name="PhotoIntervalBtn" Click="PhotoIntervalBtn_Click"
                                        Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="幻灯片间隔"/>
                                    </ToolTipService.ToolTip>
                                    <TextBlock x:Name="PhotoIntervalText" Text="3s"
                                               FontFamily="Segoe UI Semibold" FontSize="12"
                                               Foreground="#66FFFFFF" MinWidth="28" TextAlignment="Center"/>
                                </Button>
                                <Button x:Name="PhotoCloseBtn" Click="PhotoCloseBtn_Click"
                                        Style="{StaticResource ZunePrimaryStyle}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="关闭"/>
                                    </ToolTipService.ToolTip>
                                    <TextBlock Text="&#x2716;" FontFamily="Segoe UI" FontSize="14"
                                               Foreground="#FFFFFFFF"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Photo Image -->
                    <ScrollViewer Grid.Row="1" x:Name="PhotoScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ZoomMode="Enabled"
                                  DoubleTapped="PhotoScrollViewer_DoubleTapped">
                        <Image x:Name="PhotoImage"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <CompositeTransform x:Name="PhotoTransform"/>
                            </Image.RenderTransform>
                        </Image>
                    </ScrollViewer>

                    <!-- Photo Bottom Bar -->
                    <Border Grid.Row="2" VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000A0A0F" Offset="0"/>
                                <GradientStop Color="#EE0A0A0F" Offset="0.3"/>
                                <GradientStop Color="#FF0A0A0F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="32,12,32,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PhotoPrevBtn" Click="PhotoPrevBtn_Click"
                                    Style="{StaticResource ZunePrimaryStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="上一张"/>
                                </ToolTipService.ToolTip>
                                <TextBlock Text="&#x23EE;" FontFamily="Segoe UI Symbol" FontSize="18"
                                           Foreground="#FFFFFFFF"/>
                            </Button>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PhotoCounter" Text=""
                                           FontFamily="Segoe UI" FontSize="13"
                                           Foreground="#66FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PhotoInfoText" Text=""
                                           FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="PhotoNextBtn" Click="PhotoNextBtn_Click"
                                    Grid.Column="2"
                                    Style="{StaticResource ZunePrimaryStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="下一张"/>
                                </ToolTipService.ToolTip>
                                <TextBlock Text="&#x23ED;" FontFamily="Segoe UI Symbol" FontSize="18"
                                           Foreground="#FFFFFFFF"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Overlay Notification Bar -->
            <Border x:Name="OverlayNotification"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Visibility="Collapsed" Margin="32,0,32,130"
                    BorderThickness="3,0,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#E01A1A2E"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FFE040FB"/>
                </Border.BorderBrush>
                <Grid Margin="16,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OverlayIcon" Grid.Column="0"
                               Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16"
                               Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="OverlayText" Grid.Column="1"
                               Text="" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#FFFFFFFF" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="OverlayOpenBtn" Grid.Column="2"
                            Click="OverlayOpen_Click"
                            Style="{StaticResource ZuneActionStyle}"
                            Visibility="Collapsed" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4E4;" FontFamily="Segoe UI Symbol" FontSize="12"
                                       Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="打开" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Click="OverlayNotification_Close"
                            Style="{StaticResource ZunePrimaryStyle}" Margin="4,0,0,0">
                        <TextBlock Text="&#x2716;" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#88FFFFFF"/>
                    </Button>
                </Grid>
            </Border>

            <!-- A-B Repeat Indicator -->
            <Border x:Name="AbRepeatIndicator" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,80,32,0" Background="#40E040FB" Padding="12,6">
                <TextBlock x:Name="AbRepeatText" Text="A-B"
                           FontFamily="Segoe UI Semibold" FontSize="12"
                           Foreground="#FFE040FB" CharacterSpacing="40"/>
            </Border>

            <!-- EQUALIZER OVERLAY -->
            <Border x:Name="EqualizerOverlay" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="380" Background="#FF0D0D16" BorderThickness="1,0,0,0" Margin="0,0,0,0">
                <Border.BorderBrush><SolidColorBrush Color="#FFE040FB"/></Border.BorderBrush>
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="均衡器" FontFamily="Segoe UI" FontSize="14" Foreground="#FFE040FB" CharacterSpacing="60" Margin="0,0,0,12"/>
                    <ComboBox x:Name="EqPresetCombo" Grid.Row="1" Margin="0,0,0,12" SelectionChanged="EqPresetCombo_SelectionChanged"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <StackPanel x:Name="EqBandsPanel"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Click="EqSaveCustom_Click" Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,8,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="保存当前设置为自定义预置"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="保存自定义" FontFamily="Segoe UI" FontSize="12" Foreground="#99FFFFFF"/>
                        </Button>
                        <Button Click="EqualizerOverlay_Close" Style="{StaticResource ZuneActionStyle}">
                            <TextBlock Text="关闭" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIDEO FILTER OVERLAY -->
            <Border x:Name="VideoFilterOverlay" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="360" Background="#FF0D0D16" BorderThickness="1,0,0,0">
                <Border.BorderBrush><SolidColorBrush Color="#FFE040FB"/></Border.BorderBrush>
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="视频滤镜" FontFamily="Segoe UI" FontSize="14" Foreground="#FFE040FB" CharacterSpacing="60" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="亮度" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="2" Value="1" StepFrequency="0.05" ValueChanged="BrightnessSlider_ValueChanged"/>
                        <TextBlock Text="对比度" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="ContrastSlider" Minimum="0" Maximum="2" Value="1" StepFrequency="0.05" ValueChanged="ContrastSlider_ValueChanged"/>
                        <TextBlock Text="色调" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="HueSlider" Minimum="-180" Maximum="180" Value="0" StepFrequency="1" ValueChanged="HueSlider_ValueChanged"/>
                        <TextBlock Text="饱和度" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="SaturationSlider" Minimum="0" Maximum="3" Value="1" StepFrequency="0.05" ValueChanged="SaturationSlider_ValueChanged"/>
                        <TextBlock Text="伽马" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="GammaSlider" Minimum="0.5" Maximum="2" Value="1" StepFrequency="0.05" ValueChanged="GammaSlider_ValueChanged"/>
                        <Button x:Name="FilterResetBtn" Click="FilterResetBtn_Click"
                                Style="{StaticResource ZunePrimaryStyle}" HorizontalAlignment="Left"
                                Margin="0,12,0,0">
                            <TextBlock Text="重置为默认" FontFamily="Segoe UI" FontSize="12" Foreground="#99FFFFFF"/>
                        </Button>
                    </StackPanel>
                    <Button Grid.Row="2" Click="VideoFilterOverlay_Close" HorizontalAlignment="Right" Margin="0,12,0,0" Style="{StaticResource ZuneActionStyle}">
                        <TextBlock Text="关闭" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- STATS OSD -->
            <Border x:Name="StatsOverlay" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="32,80,0,0" Background="#CC0D0D16" Padding="16,12" BorderThickness="1,0,0,0">
                <Border.BorderBrush><SolidColorBrush Color="#FFE040FB"/></Border.BorderBrush>
                <StackPanel>
                    <TextBlock Text="播放统计" FontFamily="Segoe UI" FontSize="12" Foreground="#FFE040FB" CharacterSpacing="60" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StatsText" Text="" FontFamily="Consolas" FontSize="11" Foreground="#AAFFFFFF" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- MINI PLAYER -->
            <Border x:Name="MiniPlayerOverlay" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24" Background="#D9080910"
                    BorderThickness="1" BorderBrush="#44E040FB">
                <StackPanel Orientation="Horizontal" Margin="12,8">
                    <Image x:Name="MiniPlayerArt" Width="40" Height="40" Stretch="Uniform"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MiniPlayerTitle" Text="" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#AAFFFFFF" VerticalAlignment="Center"
                                   MaxWidth="200" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <Image x:Name="MiniVisImage" Width="120" Height="32" Stretch="Fill"
                               VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="MiniPlayPauseBtn" Click="MiniPlayPauseBtn_Click"
                            Style="{StaticResource ZunePrimaryStyle}" Padding="10,6">
                        <TextBlock x:Name="MiniPlayPauseIcon" Text="&#x2016;" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="#FFFFFFFF"/>
                    </Button>
                    <Button Click="MiniPrevBtn_Click"
                            Style="{StaticResource ZunePrimaryStyle}" Padding="10,6" Margin="2,0,0,0">
                        <TextBlock Text="&#x25C0;" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="#FFFFFFFF"/>
                    </Button>
                    <Button Click="MiniNextBtn_Click"
                            Style="{StaticResource ZunePrimaryStyle}" Padding="10,6" Margin="2,0,0,0">
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="#FFFFFFFF"/>
                    </Button>
                    <Button Click="MiniExitBtn_Click"
                            Style="{StaticResource ZunePrimaryStyle}" Padding="10,6" Margin="2,0,0,0">
                        <TextBlock Text="&#x2716;" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="#88FFFFFF"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- KEYBOARD SHORTCUTS OVERLAY -->
            <Border x:Name="ShortcutsOverlay" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="500" Background="#FF0D0D16" BorderThickness="1,0,0,0" Padding="28,24">
                <Border.BorderBrush><SolidColorBrush Color="#FFE040FB"/></Border.BorderBrush>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="键盘快捷键" FontFamily="Segoe UI" FontSize="15" Foreground="#FFE040FB" CharacterSpacing="60" Margin="0,0,0,16"/>
                    <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="播放控制" Foreground="#44FFFFFF" FontSize="11" CharacterSpacing="60" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="SPACE" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="播放 / 暂停" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text=". / ," Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="下一帧 / 上一帧" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="← →" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="快进 / 快退 10s" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="↑ ↓" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="音量 +5% / -5%" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="F" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="切换全屏" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <TextBlock Text="同步调节" Foreground="#44FFFFFF" FontSize="11" CharacterSpacing="60" Margin="0,12,0,8"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+←→" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="音频延迟 ±50ms" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+↑↓" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="字幕延迟 ±50ms" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <TextBlock Text="功能" Foreground="#44FFFFFF" FontSize="11" CharacterSpacing="60" Margin="0,12,0,8"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+O" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="打开文件" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+U" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="打开网址" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+N/P" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="下一个 / 上一个" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+E" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="打开文件所在目录" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+I" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="播放统计" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="S" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="截图" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+S" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="截图连拍 (3张)" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+B" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="添加 / 移除书签" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Shift+B" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="书签列表" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Alt+←→" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="A-B 点微调 ±40ms" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="B" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="A-B 循环" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="L" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="播放列表" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="?" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="显示此帮助" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <TextBlock Text="图像调节" Foreground="#44FFFFFF" FontSize="11" CharacterSpacing="60" Margin="0,12,0,8"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Shift+↑↓" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="亮度 ±" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Shift+←→" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="对比度 ±" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Alt+←→" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="A-B 点微调 ±40ms" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#18FFFFFF" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="M" Foreground="#AAFFFFFF" FontSize="11"/></Border><TextBlock Grid.Column="1" Text="迷你播放器" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Click="ShortcutsOverlay_Close" HorizontalAlignment="Right" Margin="0,12,0,0" Style="{StaticResource ZuneActionStyle}">
                        <TextBlock Text="关闭" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- MEDIA INFO OVERLAY -->
            <Border x:Name="MediaInfoOverlay" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="480" MaxWidth="600" Background="#FF0D0D16"
                    BorderThickness="1,0,0,0" Margin="0,0,0,60">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FFE040FB"/>
                </Border.BorderBrush>
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="媒体信息"
                               FontFamily="Segoe UI" FontSize="15" Foreground="#FFE040FB"
                               CharacterSpacing="60" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  MaxHeight="420">
                        <StackPanel x:Name="MediaInfoPanel">
                            <TextBlock x:Name="MediaInfoFileName"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock x:Name="MediaInfoFileSize"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MediaInfoDuration"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MediaInfoVideoTrack"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MediaInfoAudioTrack"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MediaInfoSubCount"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MediaInfoMetaTitle"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MediaInfoMetaArtist"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MediaInfoMetaAlbum"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MediaInfoMetaDate"
                                       Text="" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Click="MediaInfoOverlay_Close"
                            HorizontalAlignment="Right" Margin="0,12,0,0"
                            Style="{StaticResource ZuneActionStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2716;" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="关闭" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- TOP BAR -->
            <Border x:Name="TopBar" VerticalAlignment="Top"
                    Visibility="Collapsed" IsHitTestVisible="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DD0A0A0F" Offset="0"/>
                        <GradientStop Color="#000A0A0F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="32,20,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HomeButton" Click="HomeButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,20,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="返回主页"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x2190;" FontFamily="Segoe UI" FontSize="18"
                                       Foreground="#FFFFFFFF"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FileNameText" Text=""
                                           Foreground="#FFFFFFFF" FontFamily="Segoe UI Semibold" FontSize="15"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                <TextBlock x:Name="PlaylistCounter" Text=""
                                           Foreground="#66FFFFFF" FontFamily="Segoe UI" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusText" Text="就绪"
                                       Foreground="#66FFFFFF" FontFamily="Segoe UI" FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Click="SettingsButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="设置"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="16"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="SubtitleButton" Click="SubtitleButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="字幕"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="CC" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="AudioTrackButton" Click="AudioTrackButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="音轨"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x1F50A;" FontFamily="Segoe UI Symbol" FontSize="14"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="MediaInfoButton" Click="MediaInfoButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="媒体信息"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x2139;" FontFamily="Segoe UI Symbol" FontSize="16"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="SnapshotButton" Click="SnapshotButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="截图"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Symbol" FontSize="14"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="RatingBtn" Click="RatingBtn_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="媒体评分"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x2606;" FontFamily="Segoe UI Symbol" FontSize="14"
                                       Foreground="#FFE040FB"/>
                        </Button>

                        <Button x:Name="BookmarkBtn" Click="BookmarkBtn_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="书签 (Ctrl+B 添加 / Ctrl+Shift+B 查看)"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x1F516;" FontFamily="Segoe UI Symbol" FontSize="14"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="SpeedButton" Click="SpeedButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0" MinWidth="40">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="播放速度"/>
                            </ToolTipService.ToolTip>
                            <TextBlock x:Name="SpeedIcon" Text="1x"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF" HorizontalAlignment="Center" Width="32"/>
                        </Button>
                        <Button x:Name="FullscreenButton" Click="FullscreenButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="全屏 (F)"/>
                            </ToolTipService.ToolTip>
                            <TextBlock x:Name="FullscreenIcon" Text="&#x26F6;"
                                       FontFamily="Segoe UI Symbol" FontSize="18"
                                       Foreground="#FFFFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BOTTOM BAR -->
            <Border x:Name="BottomBar" VerticalAlignment="Bottom"
                    Visibility="Collapsed" IsHitTestVisible="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000A0A0F" Offset="0"/>
                        <GradientStop Color="#EE0A0A0F" Offset="0.3"/>
                        <GradientStop Color="#FF0A0A0F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="32,20,32,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Seek -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                                   Text="0:00" Foreground="#FFFFFFFF" FontFamily="Segoe UI Light" FontSize="28"
                                   VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <Slider x:Name="PositionSlider" Grid.Column="1"
                                Minimum="0" Maximum="100"
                                ValueChanged="PositionSlider_ValueChanged"
                                ManipulationStarted="PositionSlider_ManipulationStarted"
                                ManipulationCompleted="PositionSlider_ManipulationCompleted"
                                VerticalAlignment="Center" Height="40"/>

                        <TextBlock x:Name="DurationText" Grid.Column="2"
                                   Text="0:00" Foreground="#55FFFFFF" FontFamily="Segoe UI Light" FontSize="18"
                                   VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Grid>

                    <!-- Row 2: Transport -->
                    <Grid Grid.Row="1" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left group: playback controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Button x:Name="PrevButton"
                                    Style="{StaticResource ZunePrimaryStyle}"
                                    Click="PrevButton_Click" Margin="0,0,4,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="上一个"/>
                                </ToolTipService.ToolTip>
                                <TextBlock Text="&#x23EE;" FontFamily="Segoe UI Symbol" FontSize="18"
                                           Foreground="#FFFFFFFF"/>
                            </Button>

                            <Button x:Name="PlayPauseButton"
                                    Style="{StaticResource ZunePrimaryStyle}"
                                    Click="PlayPauseButton_Click" Margin="0,0,4,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="播放 / 暂停 (空格)"/>
                                </ToolTipService.ToolTip>
                                <TextBlock x:Name="PlayPauseIcon" Text="&#x25B6;"
                                           FontFamily="Segoe UI Symbol" FontSize="24"
                                           Foreground="#FFFFFFFF" Margin="2,0,0,0"/>
                            </Button>

                            <Button x:Name="StopButton"
                                    Style="{StaticResource ZunePrimaryStyle}"
                                    Click="StopButton_Click" Margin="0,0,4,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="停止"/>
                                </ToolTipService.ToolTip>
                                <TextBlock Text="&#x25A0;" FontFamily="Segoe UI Symbol" FontSize="18"
                                           Foreground="#FFFFFFFF"/>
                            </Button>

                            <Button x:Name="NextButton"
                                    Style="{StaticResource ZunePrimaryStyle}"
                                    Click="NextButton_Click" Margin="0,0,16,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="下一个"/>
                                </ToolTipService.ToolTip>
                                <TextBlock Text="&#x23ED;" FontFamily="Segoe UI Symbol" FontSize="18"
                                           Foreground="#FFFFFFFF"/>
                            </Button>

                            <Button x:Name="RepeatButton"
                                    Style="{StaticResource ZunePrimaryStyle}"
                                    Click="RepeatButton_Click" Margin="0,0,4,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="循环 (关 / 全部 / 单曲)"/>
                                </ToolTipService.ToolTip>
                                <TextBlock x:Name="RepeatIcon" Text="&#x1F501;"
                                           FontFamily="Segoe UI Symbol" FontSize="16"
                                           Foreground="#66FFFFFF"/>
                            </Button>

                            <Button x:Name="ShuffleButton"
                                    Style="{StaticResource ZunePrimaryStyle}"
                                    Click="ShuffleButton_Click" Margin="0,0,4,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="随机播放"/>
                                </ToolTipService.ToolTip>
                                <TextBlock x:Name="ShuffleIcon" Text="&#x1F500;"
                                           FontFamily="Segoe UI Symbol" FontSize="16"
                                           Foreground="#66FFFFFF"/>
                            </Button>
                        </StackPanel>

                        <!-- Right group: volume + toggles -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="MuteButton"
                                    Style="{StaticResource ZunePrimaryStyle}"
                                    Click="MuteButton_Click" Margin="0,0,8,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="静音 / 取消静音"/>
                                </ToolTipService.ToolTip>
                                <TextBlock x:Name="VolumeIcon" Text="&#x1F50A;"
                                           FontFamily="Segoe UI Symbol" FontSize="16"
                                           Foreground="#FFFFFFFF"/>
                            </Button>

                            <Slider x:Name="VolumeSlider"
                                    Width="90" Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    VerticalAlignment="Center" Height="36" Margin="0,0,8,0"/>

                            <Button x:Name="PlaylistToggleButton"
                                    Style="{StaticResource ZunePrimaryStyle}"
                                    Click="PlaylistToggleButton_Click" Margin="0,0,4,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="播放列表"/>
                                </ToolTipService.ToolTip>
                                <TextBlock Text="&#x2630;" FontFamily="Segoe UI Symbol" FontSize="16"
                                           Foreground="#FFFFFFFF"/>
                            </Button>

                            <Button x:Name="LyricsToggleBtn"
                                    Click="LyricsToggleBtn_Click" Tag="hide"
                                    Padding="16,10"
                                    Style="{StaticResource ZunePrimaryStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="歌词 / 可视化切换"/>
                                </ToolTipService.ToolTip>
                                <TextBlock x:Name="LyricsToggleText" Text="歌词"
                                           FontFamily="Segoe UI" FontSize="14" Foreground="#FFFFFFFF"/>
                            </Button>

                            <Button x:Name="VisStyleBtn"
                                    Click="VisStyleBtn_Click"
                                    Padding="16,10"
                                    Style="{StaticResource ZunePrimaryStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="可视化风格"/>
                                </ToolTipService.ToolTip>
                                <TextBlock x:Name="VisStyleText" Text="&#x25D9;"
                                           FontFamily="Segoe UI Symbol" FontSize="18" Foreground="#FFFFFFFF"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- PLAYLIST SIDEBAR -->
        <Border x:Name="PlaylistSidebar" Grid.Column="1"
                Width="360" Visibility="Collapsed"
                Background="#FF030307"
                BorderThickness="1,0,0,0">
            <Border.BorderBrush>
                <SolidColorBrush Color="#22E040FB"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="20,16,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="播放列表" FontFamily="Segoe UI" FontSize="14"
                               Foreground="#FFE040FB" CharacterSpacing="60"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Click="PlaylistSaveLibrary_Click"
                                Style="{StaticResource ZunePrimaryStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="保存为歌单"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x1F4BE;" FontFamily="Segoe UI Symbol" FontSize="12"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button Click="PlaylistImportM3u_Click"
                                Style="{StaticResource ZunePrimaryStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="导入 M3U 播放列表"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x1F4E5;" FontFamily="Segoe UI Symbol" FontSize="12"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button Click="PlaylistExportM3u_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="4,0,0,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="导出 M3U 播放列表"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x1F4E4;" FontFamily="Segoe UI Symbol" FontSize="12"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button Click="PlaylistClearButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="4,0,0,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="清空播放列表"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x2716;" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Search -->
                <TextBox x:Name="PlaylistSearchBox" Grid.Row="1"
                         Margin="16,0,16,8" Height="32" FontSize="13"
                         PlaceholderText="搜索播放列表... (Esc 清除)"
                         TextChanged="PlaylistSearchBox_TextChanged"
                         KeyDown="PlaylistSearchBox_KeyDown"/>

                <!-- Items -->
                <ListBox x:Name="PlaylistListBox" Grid.Row="2"
                         SelectionChanged="PlaylistListBox_SelectionChanged"
                         Margin="0,0,0,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ZuneListBoxItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,10,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="28" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Index}"
                                               FontFamily="Segoe UI" FontSize="12"
                                               Foreground="#6E6E78"
                                               TextAlignment="Right" Margin="0,0,12,0"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                                               Foreground="#FFE040FB" TextAlignment="Right" Margin="0,0,12,0"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               FontFamily="Segoe UI" FontSize="13"
                                               Foreground="{Binding IsCurrent, Converter={StaticResource BoolToBrushConverter}}"
                                               FontWeight="{Binding IsCurrent, Converter={StaticResource BoolToFontWeightConverter}}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DurationText}"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#6E6E78" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Click="PlaylistItemMoveUp_Click"
                                            Tag="{Binding Index}"
                                            Style="{StaticResource ZunePrimaryStyle}"
                                            Padding="4,2" Margin="0,0,2,0">
                                        <TextBlock Text="&#x25B2;" FontFamily="Segoe UI Symbol" FontSize="10"
                                                   Foreground="#6E6E78"/>
                                    </Button>
                                    <Button Click="PlaylistItemMoveDown_Click"
                                            Tag="{Binding Index}"
                                            Style="{StaticResource ZunePrimaryStyle}"
                                            Padding="4,2">
                                        <TextBlock Text="&#x25BC;" FontFamily="Segoe UI Symbol" FontSize="10"
                                                   Foreground="#6E6E78"/>
                                    </Button>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Click="PlaylistItemDelete_Click"
                                        Tag="{Binding Index}"
                                        Style="{StaticResource ZunePrimaryStyle}"
                                        Padding="6,4" Margin="4,0,0,0">
                                    <TextBlock Text="&#x2716;" FontFamily="Segoe UI" FontSize="12"
                                               Foreground="#55555E"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <TextBlock x:Name="PlaylistEmptyText" Grid.Row="2"
                           Text="暂无播放项目" FontFamily="Segoe UI" FontSize="14"
                           Foreground="#33FFFFFF" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Visible"/>
            </Grid>
        </Border>
    </Grid>
</Page>
