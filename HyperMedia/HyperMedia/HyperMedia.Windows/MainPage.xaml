<Page
    x:Class="HyperMedia.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    PointerMoved="Page_PointerMoved"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Background="Black">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video / Content Area -->
        <Grid Grid.Row="1" Background="Black" DoubleTapped="VideoArea_DoubleTapped"
              Tapped="VideoArea_Tapped">
            <SwapChainPanel x:Name="VlcVideoPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="VlcVideoPanel_SizeChanged"/>
            <Image x:Name="VideoImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
            <MediaElement x:Name="AudioPlayer"
                          AutoPlay="False"
                          IsMuted="False"
                          Volume="1.0"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MediaFailed="MediaPlayer_MediaFailed"
                          MediaEnded="MediaPlayer_MediaEnded"
                          Visibility="Collapsed"/>

            <!-- Welcome Screen -->
            <Border x:Name="WelcomeScreen"
                    Background="#AA000000"
                    Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="48"
                               Foreground="#44FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="HyperMedia"
                               FontFamily="Segoe UI Light" FontSize="28"
                               Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Open a file or drag and drop to play"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="#88FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Center Play/Pause Button -->
            <Border x:Name="CenterPlayButton"
                    Background="#44000000"
                    CornerRadius="40"
                    Width="80" Height="80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Tapped="CenterPlayButton_Tapped">
                <TextBlock x:Name="CenterPlayIcon" Text="&#x25B6;"
                           FontFamily="Segoe UI Symbol" FontSize="28"
                           Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Top Overlay -->
            <Border x:Name="TopBar" Grid.Row="0"
                    Background="#CC000000" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FileNameText" Grid.Column="0"
                               Text="" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="14"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400"/>

                    <TextBlock x:Name="StatusText" Grid.Column="2"
                               Text="Ready" Foreground="#99FFFFFF" FontFamily="Segoe UI" FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Overlay Message -->
            <TextBlock x:Name="OverlayText"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="13"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,100"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Bottom Overlay Control Bar -->
        <Border x:Name="BottomBar" Grid.Row="2"
                Background="#CC000000" Padding="12,0,12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Seek Slider (full width) -->
                <Grid Grid.Row="0" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                               Text="00:00" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Slider x:Name="PositionSlider" Grid.Column="1"
                            Minimum="0" Maximum="100"
                            ValueChanged="PositionSlider_ValueChanged"
                            ManipulationStarted="PositionSlider_ManipulationStarted"
                            ManipulationCompleted="PositionSlider_ManipulationCompleted"
                            VerticalAlignment="Center"/>

                    <TextBlock x:Name="DurationText" Grid.Column="2"
                               Text="00:00" Foreground="#99FFFFFF" FontFamily="Segoe UI" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Row 2: Transport Controls -->
                <Grid Grid.Row="1" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Play/Pause -->
                    <Button x:Name="PlayPauseButton" Grid.Column="0"
                            Background="Transparent" BorderBrush="Transparent"
                            Padding="10,6" Click="PlayPauseButton_Click">
                        <TextBlock x:Name="PlayPauseIcon" Text="&#x25B6;"
                                   FontFamily="Segoe UI Symbol" FontSize="16"
                                   Foreground="#FFFFFFFF"/>
                    </Button>

                    <!-- Stop -->
                    <Button x:Name="StopButton" Grid.Column="1"
                            Background="Transparent" BorderBrush="Transparent"
                            Padding="10,6" Click="StopButton_Click">
                        <TextBlock Text="&#x25A0;" FontFamily="Segoe UI Symbol" FontSize="16"
                                   Foreground="#FFFFFFFF"/>
                    </Button>

                    <!-- Back to Home -->
                    <Button x:Name="HomeButton" Grid.Column="2"
                            Background="Transparent" BorderBrush="Transparent"
                            Padding="10,6" Click="HomeButton_Click">
                        <TextBlock Text="&#x2302;" FontFamily="Segoe UI Symbol" FontSize="16"
                                   Foreground="#FFFFFFFF"/>
                    </Button>

                    <!-- Spacer -->
                    <Grid Grid.Column="3"/>

                    <!-- Volume -->
                    <TextBlock x:Name="VolumeIcon" Grid.Column="4"
                               Text="&#x1F50A;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#FFFFFFFF" VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="5"
                            Width="100"
                            Minimum="0" Maximum="100" Value="100"
                            ValueChanged="VolumeSlider_ValueChanged"
                            VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
