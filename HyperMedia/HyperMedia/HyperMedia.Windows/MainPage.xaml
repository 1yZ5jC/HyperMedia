<Page
    x:Class="HyperMedia.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    PointerMoved="Page_PointerMoved"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Background="#FF0A0A0F">

    <Grid x:Name="RootGrid">

        <!-- VIDEO AREA -->
        <Grid Background="Black" DoubleTapped="VideoArea_DoubleTapped"
              Tapped="VideoArea_Tapped"
              ManipulationStarted="VideoArea_ManipulationStarted"
              ManipulationDelta="VideoArea_ManipulationDelta"
              ManipulationCompleted="VideoArea_ManipulationCompleted"
              ManipulationMode="TranslateX,TranslateY">
            <SwapChainPanel x:Name="VlcVideoPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="VlcVideoPanel_SizeChanged"/>

            <!-- WELCOME SCREEN -->
            <Border x:Name="WelcomeScreen" Visibility="Visible">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                            <GradientStop Color="#FF0A0A0F" Offset="0"/>
                            <GradientStop Color="#FF12081A" Offset="0.5"/>
                            <GradientStop Color="#FF0A0A0F" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,24,0,0">
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                                   Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#66FFFFFF" VerticalAlignment="Center" CharacterSpacing="80"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="32,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock Text="欢迎" FontFamily="Segoe UI Light" FontSize="56"
                                       Foreground="#FFFFFFFF" Margin="0,0,0,8"/>
                            <TextBlock Text="拖放文件到这里，按 Ctrl+O 打开，或输入网络地址"
                                       FontFamily="Segoe UI" FontSize="18"
                                       Foreground="#66FFFFFF" Margin="0,0,0,32"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button x:Name="WelcomeOpenButton" Click="WelcomeOpenButton_Click"
                                        Style="{StaticResource ZuneActionStyle}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4C2;" FontFamily="Segoe UI Symbol" FontSize="14"
                                                   Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="打开文件" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                                   FontSize="12" VerticalAlignment="Center" CharacterSpacing="40"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WelcomeUrlButton" Click="UrlButton_Click"
                                        Style="{StaticResource ZuneActionStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F310;" FontFamily="Segoe UI Symbol" FontSize="14"
                                                   Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="打开网址" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                                   FontSize="12" VerticalAlignment="Center" CharacterSpacing="40"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="MP4" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="MKV" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="AVI" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="MP3" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <Border Background="#15FFFFFF" CornerRadius="0" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="FLAC" Foreground="#55FFFFFF" FontFamily="Segoe UI" FontSize="10"/>
                                </Border>
                                <TextBlock Text="+ HTTP, RTSP, MMS..." FontFamily="Segoe UI" FontSize="10"
                                           Foreground="#33FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="64,0,32,0">
                            <TextBlock Text="快捷键" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#44FFFFFF" CharacterSpacing="60" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="SPACE" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="播放 / 暂停"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#x2190; &#x2192;" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="快进 / 快退"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="F" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="切换全屏"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="A-B" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="A-B 循环播放"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#18FFFFFF" CornerRadius="0" Padding="12,6"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#x2191; &#x2193;" FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAFFFFFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="音量增大 / 减小"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#55FFFFFF"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="HyperMedia — 您的全能媒体播放器"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#22FFFFFF"
                               HorizontalAlignment="Left" Margin="32,0,0,20"/>
                </Grid>
            </Border>

            <!-- Swipe Indicator -->
            <StackPanel x:Name="SwipeIndicator" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" Margin="0,0,0,80">
                <Border Background="#40E040FB" CornerRadius="0" Padding="20,10" Margin="0,0,8,0">
                    <TextBlock Text="&#x2190; 后退" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="12"
                               CharacterSpacing="40"/>
                </Border>
                <Border Background="#4000BCD4" CornerRadius="0" Padding="20,10">
                    <TextBlock Text="快进 &#x2192;" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="12"
                               CharacterSpacing="40"/>
                </Border>
            </StackPanel>

            <!-- MUSIC: Album Art + Lyrics (shown for audio files) -->
            <Grid x:Name="MusicOverlay" Visibility="Collapsed" Margin="0,60,0,0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF0A0A0F" Offset="0"/>
                        <GradientStop Color="#CC12081A" Offset="0.5"/>
                        <GradientStop Color="#FF0A0A0F" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Album Art -->
                <Border x:Name="AlbumArtBorder" Grid.Column="0"
                        Margin="80,0,48,0" Width="320" Height="320"
                        CornerRadius="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        BorderThickness="3,0,0,0">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FFE040FB"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="#FF1A1A2E"/>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="AlbumArtImage" Grid.Row="0"
                               Stretch="UniformToFill" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="AlbumArtPlaceholder" Grid.Row="0"
                                   Text="&#x266B;" FontFamily="Segoe UI Symbol" FontSize="80"
                                   Foreground="#33E040FB" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="AlbumArtMetaText" Grid.Row="1"
                                   Text="" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#66FFFFFF" TextAlignment="Center"
                                   Padding="12,8,12,12" TextWrapping="Wrap"
                                   MaxWidth="320"/>
                    </Grid>
                </Border>

                <!-- Lyrics -->
                <Border x:Name="LyricsBorder" Grid.Column="1"
                        Margin="0,32,64,32" CornerRadius="0"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <SolidColorBrush Color="#10FFFFFF"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#22E040FB"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>1,0,0,0</Thickness>
                    </Border.BorderThickness>
                    <Grid Margin="24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LyricsTitle" Grid.Row="0"
                                   Text="歌词" FontFamily="Segoe UI" FontSize="14"
                                   Foreground="#44E040FB" CharacterSpacing="80"
                                   Margin="0,0,0,16"/>
                        <ScrollViewer x:Name="LyricsScrollViewer" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LyricsLines">
                                <TextBlock x:Name="LyricsPlaceholder"
                                           Text="暂无歌词"
                                           FontFamily="Segoe UI" FontSize="16"
                                           Foreground="#44FFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Overlay Notification Bar -->
            <Border x:Name="OverlayNotification"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Visibility="Collapsed" Margin="32,0,32,130"
                    BorderThickness="3,0,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#E01A1A2E"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FFE040FB"/>
                </Border.BorderBrush>
                <Grid Margin="16,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OverlayIcon" Grid.Column="0"
                               Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16"
                               Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="OverlayText" Grid.Column="1"
                               Text="" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#FFFFFFFF" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="OverlayOpenBtn" Grid.Column="2"
                            Click="OverlayOpen_Click"
                            Style="{StaticResource ZuneActionStyle}"
                            Visibility="Collapsed" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4E4;" FontFamily="Segoe UI Symbol" FontSize="12"
                                       Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="打开" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Click="OverlayNotification_Close"
                            Style="{StaticResource ZunePrimaryStyle}" Margin="4,0,0,0">
                        <TextBlock Text="&#x2716;" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#88FFFFFF"/>
                    </Button>
                </Grid>
            </Border>

            <!-- A-B Repeat Indicator -->
            <Border x:Name="AbRepeatIndicator" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,80,32,0" Background="#40E040FB" Padding="12,6">
                <TextBlock x:Name="AbRepeatText" Text="A-B"
                           FontFamily="Segoe UI Semibold" FontSize="12"
                           Foreground="#FFE040FB" CharacterSpacing="40"/>
            </Border>

            <!-- TOP BAR -->
            <Border x:Name="TopBar" VerticalAlignment="Top"
                    Visibility="Collapsed" IsHitTestVisible="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DD0A0A0F" Offset="0"/>
                        <GradientStop Color="#000A0A0F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="32,20,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HomeButton" Click="HomeButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,20,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="返回主页"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x2190;" FontFamily="Segoe UI" FontSize="18"
                                       Foreground="#FFFFFFFF"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FileNameText" Text=""
                                           Foreground="#FFFFFFFF" FontFamily="Segoe UI Semibold" FontSize="15"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                <TextBlock x:Name="PlaylistCounter" Text=""
                                           Foreground="#66FFFFFF" FontFamily="Segoe UI" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusText" Text="就绪"
                                       Foreground="#66FFFFFF" FontFamily="Segoe UI" FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Click="SettingsButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="设置"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="16"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="SubtitleButton" Click="SubtitleButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="字幕"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="CC" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="AudioTrackButton" Click="AudioTrackButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="音轨"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x1F50A;" FontFamily="Segoe UI Symbol" FontSize="14"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="SnapshotButton" Click="SnapshotButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="截图"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Symbol" FontSize="14"
                                       Foreground="#66FFFFFF"/>
                        </Button>
                        <Button x:Name="SpeedButton" Click="SpeedButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="播放速度"/>
                            </ToolTipService.ToolTip>
                            <TextBlock x:Name="SpeedIcon" Text="1x"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF"/>
                        </Button>
                        <Button x:Name="FullscreenButton" Click="FullscreenButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="全屏 (F)"/>
                            </ToolTipService.ToolTip>
                            <TextBlock x:Name="FullscreenIcon" Text="&#x26F6;"
                                       FontFamily="Segoe UI Symbol" FontSize="18"
                                       Foreground="#FFFFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BOTTOM BAR -->
            <Border x:Name="BottomBar" VerticalAlignment="Bottom"
                    Visibility="Collapsed" IsHitTestVisible="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000A0A0F" Offset="0"/>
                        <GradientStop Color="#EE0A0A0F" Offset="0.3"/>
                        <GradientStop Color="#FF0A0A0F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="32,20,32,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Seek -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                                   Text="0:00" Foreground="#FFFFFFFF" FontFamily="Segoe UI Light" FontSize="28"
                                   VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <Slider x:Name="PositionSlider" Grid.Column="1"
                                Minimum="0" Maximum="100"
                                ValueChanged="PositionSlider_ValueChanged"
                                ManipulationStarted="PositionSlider_ManipulationStarted"
                                ManipulationCompleted="PositionSlider_ManipulationCompleted"
                                VerticalAlignment="Center" Height="40"/>

                        <TextBlock x:Name="DurationText" Grid.Column="2"
                                   Text="0:00" Foreground="#55FFFFFF" FontFamily="Segoe UI Light" FontSize="18"
                                   VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Grid>

                    <!-- Row 2: Transport -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevButton" Grid.Column="0"
                                Style="{StaticResource ZunePrimaryStyle}"
                                Click="PrevButton_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="上一个"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x23EE;" FontFamily="Segoe UI Symbol" FontSize="18"
                                       Foreground="#FFFFFFFF"/>
                        </Button>

                        <Button x:Name="PlayPauseButton" Grid.Column="1"
                                Style="{StaticResource ZunePrimaryStyle}"
                                Click="PlayPauseButton_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="播放 / 暂停 (空格)"/>
                            </ToolTipService.ToolTip>
                            <TextBlock x:Name="PlayPauseIcon" Text="&#x25B6;"
                                       FontFamily="Segoe UI Symbol" FontSize="24"
                                       Foreground="#FFFFFFFF" Margin="2,0,0,0"/>
                        </Button>

                        <Button x:Name="StopButton" Grid.Column="2"
                                Style="{StaticResource ZunePrimaryStyle}"
                                Click="StopButton_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="停止"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x25A0;" FontFamily="Segoe UI Symbol" FontSize="18"
                                       Foreground="#FFFFFFFF"/>
                        </Button>

                        <Button x:Name="NextButton" Grid.Column="3"
                                Style="{StaticResource ZunePrimaryStyle}"
                                Click="NextButton_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="下一个"/>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="&#x23ED;" FontFamily="Segoe UI Symbol" FontSize="18"
                                       Foreground="#FFFFFFFF"/>
                        </Button>

                        <Grid Grid.Column="4"/>

                        <Button x:Name="RepeatButton" Grid.Column="5"
                                Style="{StaticResource ZunePrimaryStyle}"
                                Click="RepeatButton_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="循环 (关 / 全部 / 单曲)"/>
                            </ToolTipService.ToolTip>
                            <TextBlock x:Name="RepeatIcon" Text="&#x1F501;"
                                       FontFamily="Segoe UI Symbol" FontSize="16"
                                       Foreground="#66FFFFFF"/>
                        </Button>

                        <Button x:Name="ShuffleButton" Grid.Column="6"
                                Style="{StaticResource ZunePrimaryStyle}"
                                Click="ShuffleButton_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="随机播放"/>
                            </ToolTipService.ToolTip>
                            <TextBlock x:Name="ShuffleIcon" Text="&#x1F500;"
                                       FontFamily="Segoe UI Symbol" FontSize="16"
                                       Foreground="#66FFFFFF"/>
                        </Button>

                        <Button x:Name="MuteButton" Grid.Column="7"
                                Style="{StaticResource ZunePrimaryStyle}"
                                Click="MuteButton_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="静音 / 取消静音"/>
                            </ToolTipService.ToolTip>
                            <TextBlock x:Name="VolumeIcon" Text="&#x1F50A;"
                                       FontFamily="Segoe UI Symbol" FontSize="16"
                                       Foreground="#FFFFFFFF"/>
                        </Button>

                        <Slider x:Name="VolumeSlider" Grid.Column="8"
                                Width="140" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="VolumeSlider_ValueChanged"
                                VerticalAlignment="Center" Height="36" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
