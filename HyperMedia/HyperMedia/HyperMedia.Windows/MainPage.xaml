<Page
    x:Class="HyperMedia.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    PointerMoved="Page_PointerMoved"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Background="#FF0A0A0F">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video / Content Area -->
        <Grid Grid.Row="1" Background="Black" DoubleTapped="VideoArea_DoubleTapped"
              Tapped="VideoArea_Tapped"
              ManipulationStarted="VideoArea_ManipulationStarted"
              ManipulationDelta="VideoArea_ManipulationDelta"
              ManipulationCompleted="VideoArea_ManipulationCompleted"
              ManipulationMode="TranslateX,TranslateY">
            <SwapChainPanel x:Name="VlcVideoPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="VlcVideoPanel_SizeChanged"/>
            <Image x:Name="VideoImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
            <MediaElement x:Name="AudioPlayer"
                          AutoPlay="False"
                          IsMuted="False"
                          Volume="1.0"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MediaFailed="MediaPlayer_MediaFailed"
                          MediaEnded="MediaPlayer_MediaEnded"
                          Visibility="Collapsed"/>

            <!-- Welcome Screen -->
            <Border x:Name="WelcomeScreen" Visibility="Visible">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                            <GradientStop Color="#FF0A0A0F" Offset="0"/>
                            <GradientStop Color="#FF12081A" Offset="0.5"/>
                            <GradientStop Color="#FF0A0A0F" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Glowing Play Icon -->
                        <Border Width="120" Height="120" CornerRadius="60"
                                BorderThickness="1.5" BorderBrush="#66E040FB"
                                HorizontalAlignment="Center" Margin="0,0,0,32">
                            <Grid Background="#10E040FB">
                                <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="44"
                                           Foreground="#FFE040FB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="HYPERMEDIA" FontFamily="Segoe UI Light" FontSize="36"
                                   Foreground="#FFFFFFFF" HorizontalAlignment="Center"
                                   Margin="0,0,0,8" CharacterSpacing="120"/>
                        <TextBlock Text="Drop a file or press Ctrl+O to open"
                                   FontFamily="Segoe UI" FontSize="14"
                                   Foreground="#55FFFFFF" HorizontalAlignment="Center"
                                   Margin="0,0,0,36"/>

                        <Button x:Name="WelcomeOpenButton" Click="WelcomeOpenButton_Click"
                                HorizontalAlignment="Center" Style="{StaticResource ZuneActionStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C2;" FontFamily="Segoe UI Symbol" FontSize="14"
                                           Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="OPEN FILE" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                           FontSize="12" VerticalAlignment="Center" CharacterSpacing="40"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Hints -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal"
                                Margin="0,0,0,24" Opacity="0.3">
                        <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#FFFFFF">
                            <Run Text="SPACE" FontFamily="Segoe UI Semibold"/>
                            <Run Text=" Play/Pause"/>
                        </TextBlock>
                        <TextBlock Text="  /  " FontFamily="Segoe UI" FontSize="11" Foreground="#66FFFFFF"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#FFFFFF">
                            <Run Text="&#x2190; &#x2192;" FontFamily="Segoe UI Semibold"/>
                            <Run Text=" Seek"/>
                        </TextBlock>
                        <TextBlock Text="  /  " FontFamily="Segoe UI" FontSize="11" Foreground="#66FFFFFF"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#FFFFFF">
                            <Run Text="F" FontFamily="Segoe UI Semibold"/>
                            <Run Text=" Fullscreen"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center Play/Pause Button -->
            <Border x:Name="CenterPlayButton"
                    Background="#30E040FB"
                    CornerRadius="48"
                    Width="96" Height="96"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Tapped="CenterPlayButton_Tapped">
                <Border BorderThickness="1.5" BorderBrush="#88E040FB" CornerRadius="48">
                    <TextBlock x:Name="CenterPlayIcon" Text="&#x25B6;"
                               FontFamily="Segoe UI Symbol" FontSize="36"
                               Foreground="#FFE040FB" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </Border>
            </Border>

            <!-- Top Overlay -->
            <Border x:Name="TopBar" Grid.Row="0" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC0A0A0F" Offset="0"/>
                        <GradientStop Color="#000A0A0F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                                   Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="FileNameText" Text=""
                                   Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="14"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Column="2"
                               Text="Ready" Foreground="#66FFFFFF" FontFamily="Segoe UI" FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Swipe Indicator -->
            <StackPanel x:Name="SwipeIndicator" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" Margin="0,0,0,80">
                <Border Background="#40E040FB" CornerRadius="20" Padding="20,10" Margin="0,0,8,0">
                    <TextBlock Text="&#x2190; PREVIOUS" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="12"
                               CharacterSpacing="40"/>
                </Border>
                <Border Background="#4000BCD4" CornerRadius="20" Padding="20,10">
                    <TextBlock Text="NEXT &#x2192;" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="12"
                               CharacterSpacing="40"/>
                </Border>
            </StackPanel>

            <!-- Overlay Message -->
            <TextBlock x:Name="OverlayText"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,120"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Bottom Control Bar -->
        <Border x:Name="BottomBar" Grid.Row="2" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000A0A0F" Offset="0"/>
                    <GradientStop Color="#EE0A0A0F" Offset="0.4"/>
                    <GradientStop Color="#FF0A0A0F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="24,0,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Seek Slider -->
                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Large Time Display -->
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                               Text="0:00" Foreground="#FFFFFFFF" FontFamily="Segoe UI Light" FontSize="28"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Slider x:Name="PositionSlider" Grid.Column="1"
                            Minimum="0" Maximum="100"
                            ValueChanged="PositionSlider_ValueChanged"
                            ManipulationStarted="PositionSlider_ManipulationStarted"
                            ManipulationCompleted="PositionSlider_ManipulationCompleted"
                            VerticalAlignment="Center" Height="36"/>

                    <TextBlock x:Name="DurationText" Grid.Column="2"
                               Text="0:00" Foreground="#55FFFFFF" FontFamily="Segoe UI Light" FontSize="16"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>

                <!-- Transport Controls -->
                <Grid Grid.Row="1" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Play/Pause -->
                    <Button x:Name="PlayPauseButton" Grid.Column="0"
                            Style="{StaticResource ZunePrimaryStyle}"
                            Click="PlayPauseButton_Click">
                        <TextBlock x:Name="PlayPauseIcon" Text="&#x25B6;"
                                   FontFamily="Segoe UI Symbol" FontSize="22"
                                   Foreground="#FFFFFFFF" Margin="2,0,0,0"/>
                    </Button>

                    <!-- Stop -->
                    <Button x:Name="StopButton" Grid.Column="1"
                            Style="{StaticResource ZunePrimaryStyle}"
                            Click="StopButton_Click">
                        <TextBlock Text="&#x25A0;" FontFamily="Segoe UI Symbol" FontSize="18"
                                   Foreground="#FFFFFFFF"/>
                    </Button>

                    <!-- Home -->
                    <Button x:Name="HomeButton" Grid.Column="2"
                            Style="{StaticResource ZunePrimaryStyle}"
                            Click="HomeButton_Click">
                        <TextBlock Text="&#x2302;" FontFamily="Segoe UI Symbol" FontSize="18"
                                   Foreground="#FFFFFFFF"/>
                    </Button>

                    <Grid Grid.Column="3"/>

                    <!-- Fullscreen -->
                    <Button x:Name="FullscreenButton" Grid.Column="4"
                            Style="{StaticResource ZunePrimaryStyle}"
                            Click="FullscreenButton_Click">
                        <TextBlock x:Name="FullscreenIcon" Text="&#x26F6;"
                                   FontFamily="Segoe UI Symbol" FontSize="18"
                                   Foreground="#FFFFFFFF"/>
                    </Button>

                    <!-- Mute -->
                    <Button x:Name="MuteButton" Grid.Column="5"
                            Style="{StaticResource ZunePrimaryStyle}"
                            Click="MuteButton_Click">
                        <TextBlock x:Name="VolumeIcon" Text="&#x1F50A;"
                                   FontFamily="Segoe UI Symbol" FontSize="16"
                                   Foreground="#FFFFFFFF"/>
                    </Button>

                    <!-- Volume Slider -->
                    <Slider x:Name="VolumeSlider" Grid.Column="6"
                            Width="120" Minimum="0" Maximum="100" Value="100"
                            ValueChanged="VolumeSlider_ValueChanged"
                            VerticalAlignment="Center" Height="36"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
