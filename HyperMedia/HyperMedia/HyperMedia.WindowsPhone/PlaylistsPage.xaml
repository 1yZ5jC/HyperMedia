<Page
    x:Class="HyperMedia.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0A0A0F">

    <Page.BottomAppBar>
        <CommandBar Background="#FF0A0A0F" IsOpen="True">
            <CommandBar.PrimaryCommands>
                <AppBarButton Label="保存当前播放列表" Click="SaveCurrentBtn_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Add"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="刷新" Click="RefreshBtn_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Refresh"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,24,24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackButton_Click" Style="{StaticResource ZuneBackButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#x2190;" FontFamily="Segoe UI" FontSize="22"
                               Foreground="#FFFFFFFF"/>
                </Button>
                <TextBlock Text="歌单" FontFamily="Segoe UI Light" FontSize="40"
                           Foreground="#FFFFFFFF" VerticalAlignment="Center"
                           CharacterSpacing="40"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="24,8,24,24">
            <StackPanel>

                <TextBlock x:Name="PageHintText" Text="轻触播放，长按删除" FontFamily="Segoe UI"
                           FontSize="19" Foreground="#55FFFFFF"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="智能歌单" FontFamily="Segoe UI" FontSize="19"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,0,0,8"/>
                <ListBox x:Name="SmartList" Background="#14000000"
                         BorderThickness="0" FontFamily="Segoe UI" FontSize="19"
                         Foreground="#E6FFFFFF"
                         ItemContainerStyle="{StaticResource ZuneListBoxItemStyle}"/>

                <TextBlock Text="我的歌单" FontFamily="Segoe UI" FontSize="19"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,20,0,8"/>
                <ListBox x:Name="PlaylistList" Background="#14000000"
                         BorderThickness="0" FontFamily="Segoe UI" FontSize="19"
                         Foreground="#E6FFFFFF"
                         ItemContainerStyle="{StaticResource ZuneListBoxItemStyle}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>