<Page
    x:Class="HyperMedia.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Background="#FF0A0A0F">

    <Grid x:Name="HomeRootGrid" Background="#FF0A0A0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Vertical single-column scroll: WP8.1 style home (Hub-like) -->
        <ScrollViewer x:Name="PanoramaScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Stretch"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.5"
                      MaxZoomFactor="1"
                      ViewChanged="PanoramaScroll_ViewChanged"
                      PointerWheelChanged="PanoramaScroll_PointerWheelChanged">

            <StackPanel Margin="26,22,26,18">

                <!-- ══════════════════════════════ -->
                <!-- Page header: brand + open      -->
                <!-- ══════════════════════════════ -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="14"
                                   Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="HomeBrandText" Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#99FFFFFF" VerticalAlignment="Center" CharacterSpacing="60"/>
                    </StackPanel>
                    <Button x:Name="OpenButton" Click="OpenButton_Click"
                            Style="{StaticResource ZuneOpenStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontFamily="Segoe UI Light" FontSize="17"
                                       Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="打开" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="13"
                                       VerticalAlignment="Center" CharacterSpacing="40"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Hero -->
                <StackPanel Margin="0,8,0,30">
                    <TextBlock x:Name="HomeTitle1" Text="全部播放" FontFamily="Segoe UI Light" FontSize="52"
                               Foreground="#FFFFFFFF" LineHeight="54"/>
                    <TextBlock x:Name="HomeTitle2" Text="随心所欲" FontFamily="Segoe UI Light" FontSize="52"
                               Foreground="#FFE040FB" LineHeight="54" Margin="0,0,0,8"/>
                    <TextBlock x:Name="HomeDesc" Text="视频、音频、图片 — 一个播放器搞定所有媒体。"
                               FontFamily="Segoe UI" FontSize="15" Foreground="#88FFFFFF"
                               Margin="0,0,0,24" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Click="OpenButton_Click" Style="{StaticResource ZuneActionStyle}" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="13"
                                           Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="打开文件" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                           FontSize="13" VerticalAlignment="Center" CharacterSpacing="30"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenUrlBtn" Click="OpenUrlButton_Click" Style="{StaticResource ZunePrimaryStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="打开网络媒体 (Ctrl+U)"/>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F310;" FontFamily="Segoe UI Symbol" FontSize="13"
                                           Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="打开网址" Foreground="#99FFFFFF" FontFamily="Segoe UI"
                                           FontSize="13" VerticalAlignment="Center" CharacterSpacing="30"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════════════════════ -->
                <!-- SECTION: VIDEOS                 -->
                <!-- ══════════════════════════════ -->
                <StackPanel x:Name="VideosSection" Margin="0,0,0,26">
                    <Border Height="1" Background="#24FFFFFF" Margin="0,0,0,18"/>
                    <TextBlock x:Name="VideosTitle" Text="视频" FontFamily="Segoe UI Light" FontSize="42"
                               Foreground="#FFFFFFFF" CharacterSpacing="40" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="MP4" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="AVI" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="MKV" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="WEBM" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="MOV" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="WMV" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,8,0,14" Tapped="VideoTile_Tapped"
                          PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F3AC;" FontFamily="Segoe UI Symbol" FontSize="20"
                                       Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="打开视频" FontFamily="Segoe UI Semibold" FontSize="14"
                                           Foreground="#FFFFFFFF"/>
                                <TextBlock Text="播放选中的视频轨道" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#77FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#AAE040FB"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel x:Name="RecentVideosPanel">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="最近播放" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#44FFFFFF" CharacterSpacing="80"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="VideosToggleBtn" Click="VideosToggle_Click"
                                        Style="{StaticResource ZuneActionStyle}"
                                        Padding="10,6">
                                    <TextBlock x:Name="VideosToggleIcon" Text="&#x25A1;" FontFamily="Segoe UI Symbol"
                                               FontSize="15" Foreground="#99E040FB"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="RecentVideosList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" Padding="10,6"
                                            Margin="0,0,0,4" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    Background="#18FFFFFF">
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="32" Height="32"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="Segoe UI" FontSize="12" Foreground="#AAFFFFFF"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ResumeText}"
                                                           FontFamily="Segoe UI" FontSize="10" Foreground="#CCE040FB"
                                                           Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}"
                                                           Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding RatingText}"
                                                               FontFamily="Segoe UI Symbol" FontSize="10" Foreground="#FFE040FB"
                                                               Visibility="{Binding RatingText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding PlayCountText}"
                                                               FontFamily="Segoe UI" FontSize="10" Foreground="#66FFFFFF"
                                                               Visibility="{Binding PlayCountText, Converter={StaticResource NullToVisibilityConverter}}"
                                                               Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="RecentVideosTiles" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20E040FB" Width="440" Height="150"
                                            Margin="0,0,8,8" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#18FFFFFF">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"/>
                                                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="20"
                                                               Foreground="#AAE040FB" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#DDE040FB" Padding="5,1"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ResumeText}" FontFamily="Segoe UI"
                                                                   FontSize="9" Foreground="#FF0A0A0F"/>
                                                    </Border>
                                                    <ProgressBar Height="3"
                                                                 Background="#66FFFFFF" Foreground="#FFE040FB"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                                 Maximum="100" Value="{Binding ResumePercent}"
                                                                 Visibility="{Binding ResumePercent, Converter={StaticResource NonNegativeToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding FileName}"
                                                       FontFamily="Segoe UI" FontSize="11" Foreground="#CCFFFFFF"
                                                       TextTrimming="CharacterEllipsis" Margin="6,4,6,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════════════════════ -->
                <!-- SECTION: MUSIC                  -->
                <!-- ══════════════════════════════ -->
                <StackPanel x:Name="MusicSection" Margin="0,0,0,26">
                    <Border Height="1" Background="#24FFFFFF" Margin="0,0,0,18"/>
                    <TextBlock x:Name="MusicTitle" Text="音乐" FontFamily="Segoe UI Light" FontSize="42"
                               Foreground="#FFFFFFFF" CharacterSpacing="40" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="MP3" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="FLAC" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="WAV" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="AAC" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="OGG" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="WMA" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,8,0,14" Tapped="MusicTile_Tapped"
                          PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F3B5;" FontFamily="Segoe UI Symbol" FontSize="20"
                                       Foreground="#FF00BCD4" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="打开音乐" FontFamily="Segoe UI Semibold" FontSize="14"
                                           Foreground="#FFFFFFFF"/>
                                <TextBlock Text="播放选中的音频轨道" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#88FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#AA00BCD4"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel x:Name="RecentMusicPanel">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="最近播放" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#44FFFFFF" CharacterSpacing="80"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="MusicToggleBtn" Click="MusicToggle_Click"
                                        Style="{StaticResource ZuneActionStyle}"
                                        Padding="10,6">
                                    <TextBlock x:Name="MusicToggleIcon" Text="&#x25A1;" FontFamily="Segoe UI Symbol"
                                               FontSize="15" Foreground="#9900BCD4"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="RecentMusicList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" Padding="10,6"
                                            Margin="0,0,0,4" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    Background="#18FFFFFF">
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="32" Height="32"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="Segoe UI" FontSize="12" Foreground="#AAFFFFFF"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ResumeText}"
                                                           FontFamily="Segoe UI" FontSize="10" Foreground="#CCE040FB"
                                                           Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}"
                                                           Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding RatingText}"
                                                               FontFamily="Segoe UI Symbol" FontSize="10" Foreground="#FFE040FB"
                                                               Visibility="{Binding RatingText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding PlayCountText}"
                                                               FontFamily="Segoe UI" FontSize="10" Foreground="#66FFFFFF"
                                                               Visibility="{Binding PlayCountText, Converter={StaticResource NullToVisibilityConverter}}"
                                                               Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="RecentMusicTiles" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2000BCD4" Width="146" Height="146"
                                            Margin="0,0,8,8" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#18FFFFFF">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"/>
                                                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                               Foreground="#AA00BCD4" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#DDE040FB" Padding="5,1"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ResumeText}" FontFamily="Segoe UI"
                                                                   FontSize="8" Foreground="#FF0A0A0F"/>
                                                    </Border>
                                                    <ProgressBar Height="3"
                                                                 Background="#66FFFFFF" Foreground="#FF00BCD4"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                                 Maximum="100" Value="{Binding ResumePercent}"
                                                                 Visibility="{Binding ResumePercent, Converter={StaticResource NonNegativeToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding FileName}"
                                                       FontFamily="Segoe UI" FontSize="10" Foreground="#CCFFFFFF"
                                                       TextTrimming="CharacterEllipsis" Margin="6,4,6,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════════════════════ -->
                <!-- SECTION: PHOTOS                 -->
                <!-- ══════════════════════════════ -->
                <StackPanel x:Name="PhotosSection" Margin="0,0,0,10">
                    <Border Height="1" Background="#24FFFFFF" Margin="0,0,0,18"/>
                    <TextBlock x:Name="PhotosTitle" Text="图片" FontFamily="Segoe UI Light" FontSize="42"
                               Foreground="#FFFFFFFF" CharacterSpacing="40" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="JPG" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="PNG" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="BMP" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="GIF" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="TIFF" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="WEBP" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,8,0,14" Tapped="PhotosTile_Tapped"
                          PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Symbol" FontSize="20"
                                       Foreground="#FF76FF00" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="打开图片" FontFamily="Segoe UI Semibold" FontSize="14"
                                           Foreground="#FFFFFFFF"/>
                                <TextBlock Text="查看选中的图片" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#88FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#AA76FF00"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel x:Name="RecentPhotosPanel">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="最近播放" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#44FFFFFF" CharacterSpacing="80"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="PhotosToggleBtn" Click="PhotosToggle_Click"
                                        Style="{StaticResource ZuneActionStyle}"
                                        Padding="10,6">
                                    <TextBlock x:Name="PhotosToggleIcon" Text="&#x25A1;" FontFamily="Segoe UI Symbol"
                                               FontSize="15" Foreground="#9976FF00"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="RecentPhotosList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" Padding="10,6"
                                            Margin="0,0,0,4" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    Background="#18FFFFFF">
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="32" Height="32"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="Segoe UI" FontSize="12" Foreground="#AAFFFFFF"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ResumeText}"
                                                           FontFamily="Segoe UI" FontSize="10" Foreground="#CCE040FB"
                                                           Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}"
                                                           Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding RatingText}"
                                                               FontFamily="Segoe UI Symbol" FontSize="10" Foreground="#FFE040FB"
                                                               Visibility="{Binding RatingText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding PlayCountText}"
                                                               FontFamily="Segoe UI" FontSize="10" Foreground="#66FFFFFF"
                                                               Visibility="{Binding PlayCountText, Converter={StaticResource NullToVisibilityConverter}}"
                                                               Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="RecentPhotosTiles" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2076FF00" Width="146" Height="150"
                                            Margin="0,0,8,8" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#18FFFFFF">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"/>
                                                    <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                               Foreground="#AA76FF00" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#DDE040FB" Padding="5,1"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ResumeText}" FontFamily="Segoe UI"
                                                                   FontSize="8" Foreground="#FF0A0A0F"/>
                                                    </Border>
                                                    <ProgressBar Height="3"
                                                                 Background="#66FFFFFF" Foreground="#FF76FF00"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                                 Maximum="100" Value="{Binding ResumePercent}"
                                                                 Visibility="{Binding ResumePercent, Converter={StaticResource NonNegativeToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding FileName}"
                                                       FontFamily="Segoe UI" FontSize="10" Foreground="#CCFFFFFF"
                                                       TextTrimming="CharacterEllipsis" Margin="6,4,6,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SEMANTIC ZOOM OVERVIEW (Zoomed-Out view)            -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="OverviewScroll" Grid.Row="0" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.5"
                      MaxZoomFactor="1"
                      ViewChanged="OverviewScroll_ViewChanged">
            <GridView x:Name="OverviewView" Visibility="Visible"
                      Background="Transparent" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OverviewView_ItemClick"
                      Padding="26,60,26,40">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left"
                                  MaximumRowsOrColumns="2"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding TileBrush}" Width="300" Height="170"
                                Margin="0,0,12,12" CornerRadius="0"
                                PointerEntered="Card_PointerEntered"
                                PointerExited="Card_PointerExited">
                            <Grid Margin="20,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol"
                                           FontSize="28" Foreground="#FFFFFFFF"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" Text="{Binding Title}"
                                           FontFamily="Segoe UI Light" FontSize="34"
                                           Foreground="#FFFFFFFF"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Row="2" Text="{Binding Subtitle}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#B3FFFFFF" Margin="0,6,0,0"
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border x:Name="HomeBottomBar" Grid.Row="1" Background="#FF0A0A0F">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#30E040FB" Offset="0"/>
                    <GradientStop Color="#2000BCD4" Offset="0.5"/>
                    <GradientStop Color="#1076FF00" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                                   Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="HomeBottomBrand" Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#55FFFFFF" VerticalAlignment="Center" CharacterSpacing="40"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="支持几乎所有媒体格式"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#33FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="LibraryButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,2,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="媒体库"/>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C1;" FontFamily="Segoe UI Symbol" FontSize="12"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="媒体库" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Click="PlaylistsButton_Click"
                                Style="{StaticResource ZunePrimaryStyle}" Margin="0,0,2,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="歌单"/>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="歌单" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="18" Background="#22FFFFFF" Margin="6,0"/>

                        <Button Click="ClearHistory_Click"
                                Style="{StaticResource ZunePrimaryAction}" Margin="0,0,4,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="清除历史"/>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F5D1;" FontFamily="Segoe UI Symbol" FontSize="12"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="清除历史" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="18" Background="#22FFFFFF" Margin="6,0"/>

                        <Button Click="SettingsButton_Click"
                                Style="{StaticResource ZunePrimaryAction}" Margin="0,0,2,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="设置"/>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="13"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="设置" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="18" Background="#22FFFFFF" Margin="6,0"/>

                        <Button x:Name="OverviewBtn" Click="OverviewButton_Click"
                                Style="{StaticResource ZunePrimaryAction}" Margin="0,0,2,0">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="语义缩放概览 (Ctrl+M)"/>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="OverviewBtnGlyph" Text="&#x1F5D4;" FontFamily="Segoe UI Symbol" FontSize="13"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="OverviewBtnText" Text="概览" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Drag & Drop Overlay -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30E040FB" Offset="0"/>
                    <GradientStop Color="#1000BCD4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="120" Height="120" CornerRadius="60"
                        BorderThickness="2" BorderBrush="#FFE040FB"
                        HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Grid Background="#10E040FB">
                        <TextBlock Text="&#x2B07;" FontFamily="Segoe UI Symbol" FontSize="48"
                                   Foreground="#FFE040FB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="拖放播放" FontFamily="Segoe UI Light" FontSize="36"
                           Foreground="#FFFFFFFF" HorizontalAlignment="Center" CharacterSpacing="80"/>
                <TextBlock Text="释放以开始播放"
                           FontFamily="Segoe UI" FontSize="16" Foreground="#66FFFFFF"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>