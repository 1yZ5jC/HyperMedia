<Page
    x:Class="HyperMedia.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Background="#FF0A0A0F">

    <Page.BottomAppBar>
        <CommandBar x:Name="HomeBottomBar" Background="#FF0A0A0F" IsOpen="True">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="12"
                               Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HomeBottomBrand" Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="12"
                               Foreground="#55FFFFFF" VerticalAlignment="Center" CharacterSpacing="40"/>
                    <TextBlock x:Name="StatusText" Text="支持几乎所有媒体格式"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#33FFFFFF"
                               VerticalAlignment="Center" Margin="16,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </CommandBar.Content>
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="OverviewBtn" Label="概览"
                              Click="OverviewButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="ViewAll"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="媒体库" Click="LibraryButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="歌单" Click="PlaylistsButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="MusicInfo"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="设置" Click="SettingsButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="清除历史" Click="ClearHistory_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Delete"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid x:Name="HomeRootGrid" Background="#FF0A0A0F">

        <!-- Horizontal Hub-style panorama: one screen-wide section each -->
        <ScrollViewer x:Name="PanoramaScroll"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.5"
                      MaxZoomFactor="1"
                      ViewChanged="PanoramaScroll_ViewChanged"
                      PointerWheelChanged="PanoramaScroll_PointerWheelChanged">

            <StackPanel Orientation="Horizontal">

                <!-- ═══════════════════════════════════════════ -->
                <!-- SECTION 1: HERO                             -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Width="{Binding ActualWidth, ElementName=PanoramaScroll}"
                      Height="{Binding ActualHeight, ElementName=PanoramaScroll}"
                      Margin="0,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,22,24,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="14"
                                       Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="HomeBrandText" Text="HYPERMEDIA" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#99FFFFFF" VerticalAlignment="Center" CharacterSpacing="60"/>
                        </StackPanel>
                        <Button x:Name="OpenButton" Click="OpenButton_Click"
                                Style="{StaticResource ZuneOpenStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontFamily="Segoe UI Light" FontSize="17"
                                           Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="打开" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="13"
                                           VerticalAlignment="Center" CharacterSpacing="40"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,0,24,0">
                        <TextBlock x:Name="HomeTitle1" Text="全部播放" FontFamily="Segoe UI Light" FontSize="48"
                                   Foreground="#FFFFFFFF" LineHeight="50"/>
                        <TextBlock x:Name="HomeTitle2" Text="随心所欲" FontFamily="Segoe UI Light" FontSize="48"
                                   Foreground="#FFE040FB" LineHeight="50" Margin="0,0,0,10"/>
                        <TextBlock x:Name="HomeDesc" Text="视频、音频、图片 — 一个播放器搞定所有媒体。"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#88FFFFFF"
                                   Margin="0,0,0,26" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OpenButton_Click" Style="{StaticResource ZuneActionStyle}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="13"
                                               Foreground="#FF0A0A0F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="打开文件" Foreground="#FF0A0A0F" FontFamily="Segoe UI Semibold"
                                               FontSize="13" VerticalAlignment="Center" CharacterSpacing="30"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenUrlBtn" Click="OpenUrlButton_Click" Style="{StaticResource ZunePrimaryStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="打开网络媒体 (Ctrl+U)"/>
                                </ToolTipService.ToolTip>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F310;" FontFamily="Segoe UI Symbol" FontSize="13"
                                               Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="打开网址" Foreground="#99FFFFFF" FontFamily="Segoe UI"
                                               FontSize="13" VerticalAlignment="Center" CharacterSpacing="30"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,0,24,16">
                        <TextBlock Text="滑动浏览" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="&#x203A;" FontFamily="Segoe UI" FontSize="26"
                                   Foreground="#44FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- SECTION 2: VIDEOS                            -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid x:Name="VideosSection"
                      Width="{Binding ActualWidth, ElementName=PanoramaScroll}"
                      Height="{Binding ActualHeight, ElementName=PanoramaScroll}"
                      Margin="0,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Height="1" Background="#30FFFFFF" Margin="0,22,0,0"/>
                    <TextBlock x:Name="VideosTitle" Grid.Row="0" Text="视频" FontFamily="Segoe UI Light" FontSize="30"
                               Foreground="#FFFFFFFF" Margin="0,34,0,0" CharacterSpacing="40"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,12,24,0">
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="MP4" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="AVI" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="MKV" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="WEBM" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="MOV" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#20E040FB" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="WMV" Foreground="#99E040FB" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="24,16,24,0" Tapped="VideoTile_Tapped"
                          PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F3AC;" FontFamily="Segoe UI Symbol" FontSize="20"
                                   Foreground="#FFE040FB" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="打开视频  &#x25B6;  播放"
                                   FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#99E040FB"
                                   VerticalAlignment="Center" CharacterSpacing="20"/>
                    </Grid>

                    <StackPanel x:Name="RecentVideosPanel" Grid.Row="3" Margin="24,0,24,12">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="最近播放" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#44FFFFFF" CharacterSpacing="80"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="VideosToggleBtn" Click="VideosToggle_Click"
                                        Style="{StaticResource ZuneActionStyle}"
                                        Padding="10,6">
                                    <TextBlock x:Name="VideosToggleIcon" Text="&#x25A1;" FontFamily="Segoe UI Symbol"
                                               FontSize="15" Foreground="#99E040FB"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="RecentVideosList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" Padding="10,6"
                                            Margin="0,0,0,4" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    Background="#18FFFFFF">
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="32" Height="32"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="Segoe UI" FontSize="11" Foreground="#AAFFFFFF"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ResumeText}"
                                                           FontFamily="Segoe UI" FontSize="9" Foreground="#CCE040FB"
                                                           Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}"
                                                           Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding RatingText}"
                                                               FontFamily="Segoe UI Symbol" FontSize="9" Foreground="#FFE040FB"
                                                               Visibility="{Binding RatingText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding PlayCountText}"
                                                               FontFamily="Segoe UI" FontSize="9" Foreground="#66FFFFFF"
                                                               Visibility="{Binding PlayCountText, Converter={StaticResource NullToVisibilityConverter}}"
                                                               Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="RecentVideosTiles" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20E040FB" Width="320" Height="150"
                                            Margin="0,0,8,8" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#18FFFFFF">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"/>
                                                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="20"
                                                               Foreground="#AAE040FB" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#DDE040FB" Padding="5,1"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ResumeText}" FontFamily="Segoe UI"
                                                                   FontSize="9" Foreground="#FF0A0A0F"/>
                                                    </Border>
                                                    <ProgressBar Height="3"
                                                                 Background="#66FFFFFF" Foreground="#FFE040FB"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                                 Maximum="100" Value="{Binding ResumePercent}"
                                                                 Visibility="{Binding ResumePercent, Converter={StaticResource NonNegativeToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding FileName}"
                                                       FontFamily="Segoe UI" FontSize="10" Foreground="#CCFFFFFF"
                                                       TextTrimming="CharacterEllipsis" Margin="6,4,6,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- SECTION 3: MUSIC                             -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid x:Name="MusicSection"
                      Width="{Binding ActualWidth, ElementName=PanoramaScroll}"
                      Height="{Binding ActualHeight, ElementName=PanoramaScroll}"
                      Margin="0,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Height="1" Background="#30FFFFFF" Margin="0,22,0,0"/>
                    <TextBlock x:Name="MusicTitle" Grid.Row="0" Text="音乐" FontFamily="Segoe UI Light" FontSize="30"
                               Foreground="#FFFFFFFF" Margin="0,34,0,0" CharacterSpacing="40"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,12,24,0">
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="MP3" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="FLAC" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="WAV" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="AAC" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="OGG" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2000BCD4" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="WMA" Foreground="#9900BCD4" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="24,16,24,0" Tapped="MusicTile_Tapped"
                          PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F3B5;" FontFamily="Segoe UI Symbol" FontSize="20"
                                   Foreground="#FF00BCD4" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="打开音乐  &#x25B6;  播放"
                                   FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#9900BCD4"
                                   VerticalAlignment="Center" CharacterSpacing="20"/>
                    </Grid>

                    <StackPanel x:Name="RecentMusicPanel" Grid.Row="3" Margin="24,0,24,12">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="最近播放" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#44FFFFFF" CharacterSpacing="80"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="MusicToggleBtn" Click="MusicToggle_Click"
                                        Style="{StaticResource ZuneActionStyle}"
                                        Padding="10,6">
                                    <TextBlock x:Name="MusicToggleIcon" Text="&#x25A1;" FontFamily="Segoe UI Symbol"
                                               FontSize="15" Foreground="#9900BCD4"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="RecentMusicList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" Padding="10,6"
                                            Margin="0,0,0,4" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    Background="#18FFFFFF">
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="32" Height="32"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="Segoe UI" FontSize="11" Foreground="#AAFFFFFF"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ResumeText}"
                                                           FontFamily="Segoe UI" FontSize="9" Foreground="#CCE040FB"
                                                           Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}"
                                                           Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding RatingText}"
                                                               FontFamily="Segoe UI Symbol" FontSize="9" Foreground="#FFE040FB"
                                                               Visibility="{Binding RatingText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding PlayCountText}"
                                                               FontFamily="Segoe UI" FontSize="9" Foreground="#66FFFFFF"
                                                               Visibility="{Binding PlayCountText, Converter={StaticResource NullToVisibilityConverter}}"
                                                               Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="RecentMusicTiles" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2000BCD4" Width="150" Height="150"
                                            Margin="0,0,8,8" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#18FFFFFF">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"/>
                                                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                               Foreground="#AA00BCD4" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#DDE040FB" Padding="5,1"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ResumeText}" FontFamily="Segoe UI"
                                                                   FontSize="8" Foreground="#FF0A0A0F"/>
                                                    </Border>
                                                    <ProgressBar Height="3"
                                                                 Background="#66FFFFFF" Foreground="#FF00BCD4"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                                 Maximum="100" Value="{Binding ResumePercent}"
                                                                 Visibility="{Binding ResumePercent, Converter={StaticResource NonNegativeToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding FileName}"
                                                       FontFamily="Segoe UI" FontSize="10" Foreground="#CCFFFFFF"
                                                       TextTrimming="CharacterEllipsis" Margin="6,4,6,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- SECTION 4: PHOTOS                            -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid x:Name="PhotosSection"
                      Width="{Binding ActualWidth, ElementName=PanoramaScroll}"
                      Height="{Binding ActualHeight, ElementName=PanoramaScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Height="1" Background="#30FFFFFF" Margin="0,22,0,0"/>
                    <TextBlock x:Name="PhotosTitle" Grid.Row="0" Text="图片" FontFamily="Segoe UI Light" FontSize="30"
                               Foreground="#FFFFFFFF" Margin="0,34,0,0" CharacterSpacing="40"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,12,24,0">
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="JPG" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="PNG" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="BMP" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="GIF" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="TIFF" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                        <Border Background="#2076FF00" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="WEBP" Foreground="#9976FF00" FontFamily="Segoe UI" FontSize="10"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="24,16,24,0" Tapped="PhotosTile_Tapped"
                          PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Symbol" FontSize="20"
                                   Foreground="#FF76FF00" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="打开图片  &#x25B6;  查看"
                                   FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#9976FF00"
                                   VerticalAlignment="Center" CharacterSpacing="20"/>
                    </Grid>

                    <StackPanel x:Name="RecentPhotosPanel" Grid.Row="3" Margin="24,0,24,12">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="最近播放" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#44FFFFFF" CharacterSpacing="80"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="PhotosToggleBtn" Click="PhotosToggle_Click"
                                        Style="{StaticResource ZuneActionStyle}"
                                        Padding="10,6">
                                    <TextBlock x:Name="PhotosToggleIcon" Text="&#x25A1;" FontFamily="Segoe UI Symbol"
                                               FontSize="15" Foreground="#9976FF00"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="RecentPhotosList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" Padding="10,6"
                                            Margin="0,0,0,4" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    Background="#18FFFFFF">
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="32" Height="32"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="Segoe UI" FontSize="11" Foreground="#AAFFFFFF"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ResumeText}"
                                                           FontFamily="Segoe UI" FontSize="9" Foreground="#CCE040FB"
                                                           Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}"
                                                           Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding RatingText}"
                                                               FontFamily="Segoe UI Symbol" FontSize="9" Foreground="#FFE040FB"
                                                               Visibility="{Binding RatingText, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding PlayCountText}"
                                                               FontFamily="Segoe UI" FontSize="9" Foreground="#66FFFFFF"
                                                               Visibility="{Binding PlayCountText, Converter={StaticResource NullToVisibilityConverter}}"
                                                               Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="RecentPhotosTiles" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2076FF00" Width="150" Height="150"
                                            Margin="0,0,8,8" Tapped="RecentItem_Tapped"
                                            RightTapped="RecentItem_RightTapped"
                                            PointerEntered="Card_PointerEntered"
                                            PointerExited="Card_PointerExited"
                                            Tag="{Binding FilePath}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#18FFFFFF">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"/>
                                                    <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                               Foreground="#AA76FF00" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#DDE040FB" Padding="5,1"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding ResumeText, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ResumeText}" FontFamily="Segoe UI"
                                                                   FontSize="8" Foreground="#FF0A0A0F"/>
                                                    </Border>
                                                    <ProgressBar Height="3"
                                                                 Background="#66FFFFFF" Foreground="#FF76FF00"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                                 Maximum="100" Value="{Binding ResumePercent}"
                                                                 Visibility="{Binding ResumePercent, Converter={StaticResource NonNegativeToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding FileName}"
                                                       FontFamily="Segoe UI" FontSize="10" Foreground="#CCFFFFFF"
                                                       TextTrimming="CharacterEllipsis" Margin="6,4,6,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SEMANTIC ZOOM OVERVIEW (Zoomed-Out view)            -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="OverviewScroll" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.5"
                      MaxZoomFactor="1"
                      ViewChanged="OverviewScroll_ViewChanged">
            <GridView x:Name="OverviewView" Visibility="Visible"
                      Background="Transparent" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OverviewView_ItemClick"
                      Padding="24,60,24,40">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left"
                                  MaximumRowsOrColumns="2"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding TileBrush}" Width="300" Height="170"
                                Margin="0,0,12,12" CornerRadius="0"
                                PointerEntered="Card_PointerEntered"
                                PointerExited="Card_PointerExited">
                            <Grid Margin="20,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol"
                                           FontSize="28" Foreground="#FFFFFFFF"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" Text="{Binding Title}"
                                           FontFamily="Segoe UI Light" FontSize="34"
                                           Foreground="#FFFFFFFF"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Row="2" Text="{Binding Subtitle}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#B3FFFFFF" Margin="0,6,0,0"
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <!-- Drag & Drop Overlay -->
        <Border x:Name="DropOverlay" Visibility="Collapsed"
                AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30E040FB" Offset="0"/>
                    <GradientStop Color="#1000BCD4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="120" Height="120" CornerRadius="60"
                        BorderThickness="2" BorderBrush="#FFE040FB"
                        HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Grid Background="#10E040FB">
                        <TextBlock Text="&#x2B07;" FontFamily="Segoe UI Symbol" FontSize="48"
                                   Foreground="#FFE040FB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="拖放播放" FontFamily="Segoe UI Light" FontSize="36"
                           Foreground="#FFFFFFFF" HorizontalAlignment="Center" CharacterSpacing="80"/>
                <TextBlock Text="释放以开始播放"
                           FontFamily="Segoe UI" FontSize="16" Foreground="#66FFFFFF"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>