<Page
    x:Class="HyperMedia.OpenUrlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0A0A0F">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,24,24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackButton_Click" Style="{StaticResource ZuneBackButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#x2190;" FontFamily="Segoe UI" FontSize="22"
                               Foreground="#FFFFFFFF"/>
                </Button>
                <TextBlock Text="打开网络媒体" FontFamily="Segoe UI Light" FontSize="40"
                           Foreground="#FFFFFFFF" VerticalAlignment="Center"
                           CharacterSpacing="40"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="24,8,24,24">
            <StackPanel>

                <TextBox x:Name="UrlBox" PlaceholderText="输入 URL(http/https/rtsp/mms)"
                         FontFamily="Segoe UI" FontSize="19" KeyDown="UrlBox_KeyDown"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="取消" Click="PlayBtn_Click" Tag="cancel"
                            Style="{StaticResource ZuneActionStyle}" Margin="0,0,8,0" FontSize="19"/>
                    <Button x:Name="PlayButton" Content="播放" Click="PlayButton_Click"
                            Style="{StaticResource ZuneOpenStyle}" FontSize="19"/>
                </StackPanel>

                <TextBlock Text="最近打开" FontFamily="Segoe UI" FontSize="19"
                           Foreground="#44FFFFFF" CharacterSpacing="80" Margin="0,24,0,8"/>
                <ListBox x:Name="UrlHistoryList" Background="#14000000"
                         BorderThickness="0" FontFamily="Segoe UI" FontSize="19"
                         Foreground="#E8FFFFFF"
                         ItemContainerStyle="{StaticResource ZuneListBoxItemStyle}"
                         MaxHeight="220"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>